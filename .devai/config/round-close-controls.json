    {
      "id": "repository-references",
      "command": ["pnpm", "run", "repository-reference:check"],
      "sources": ["**/*"],
      "outputs": ["work/rounds/R-0002/repository-reference-triage.json"]
    },
    {
      "id": "round-close-policy-materialization",
      "command": ["node", "scripts/run-round-close-controls.mjs", "policy-check"],
