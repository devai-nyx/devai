      "cycle-2": ["REPAIR_REQUIRED", "PREFLIGHT_GREEN", "NEW_CANDIDATE_FROZEN", "CYCLE_2_ACTIVE"],
      "terminal": "cycle-equals-consumed-active-cycle-and-terminal-evidence-matches"
    },
    "canonical_history": {
      "ordinals": "contiguous-starting-at-one",
      "first_predecessor": "null-only-for-DRAFT-origin",
      "subsequent_predecessor": "exact-previous-state-and-transition-digests",
      "tip": "exact-current-state-cycle-candidate-and-linked-artifact-digests",
      "skips_duplicates_and_reordering": "forbidden"
    },
    "cycle_two_requires": [
      "authenticated-cycle-one-failure",
      "exact-prior-candidate-and-manifests",
      "distinct-regenerated-candidate",
      "complete-class-repair-evidence"
    ],
    "transition_guards": {
      "NEW_CANDIDATE_FROZEN": "requires-authenticated-REPAIR_REQUIRED-in-history",
      "CYCLE_2_ACTIVE": "requires-authenticated-complete-class-repair-and-distinct-candidate"
    },
    "terminal_states": ["PASS", "ESCALATION_REQUIRED", "REVIEW_TRANSPORT_BLOCKED"],
    "terminal_scope_reentry": "forbidden",
    "scope_failure_invalidation": "delete-stale-derived-scope-only-preserve-authenticated-state-and-history",
    "history_rewrite": "forbidden",
    "transport_identity": ["round", "cycle", "candidate", "manifest-digest", "reviewer"],
    "transport_guards": {
      "attempt_one_previous_digest": "null",
      "attempt_two_previous_digest": "authenticated-attempt-one",
      "identity_change_between_attempts": "forbidden",
      "transport_binds": "state-before-only",
      "subsequent_state_transition_consumes_transport_digest": true,
      "nonzero_attempts": "authenticate-complete-persisted-predecessor-linked-population",
      "valid-result": "payload-digest-equals-result-digest-input-and-transition-consumes-transport",
      "transport-terminal": "exact-two-invalid-attempts-with-matching-terminal-transition"
    },
    "repair_evidence_guards": {
      "failed_classes": "exactly-equal-prior-result-failed-class-population",
