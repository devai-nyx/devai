  "role_paths": {
    "Architect": ["law/**", "work/rounds/**", "docs/**"],
    "Owner": ["product/**"],
    "Engineer": [
      ".devai/config/**",
      ".devai/pin/**",
      ".github/**",
      "packages/**",
      "scripts/**",
      "*.json",
      "*.yml",
      "*.yaml",
      "eslint.config.*",
      "tsconfig.*"
