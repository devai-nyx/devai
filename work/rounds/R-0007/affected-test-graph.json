{
  "schemaVersion": "1.0.0",
  "graph_version": "1.0.0",
  "round": "R-0007",
  "population": {
    "production": [
      "packages/*/src/**/*.ts",
      "packages/*/scripts/**/*.{ts,mjs}",
      "scripts/**/*.{ts,mjs}",
      "*.config.{ts,mjs,js}",
      "eslint.config.*"
    ],
    "tests": ["packages/**/tests/**/*.{ts,mjs}", "tests/**/*.{test,spec}.{ts,mjs}"],
    "classification": "complete-or-full-suite-fallback",
    "excluded": [
      {
        "selector": "packages/**/dist/**",
        "reason": "Generated outputs are validated as outputs of their producer nodes rather than classified as production inputs."
      },
      {
        "selector": "tests/types/**/*.d.ts",
        "reason": "Ambient test declarations are shared inputs and invalidate the complete test population."
      }
    ]
  },
  "shared_inputs": [
    {
      "id": "workspace",
      "selectors": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "packages/*/package.json"
      ],
      "invalidates": ["full-suite", "full-coverage"]
    },
    {
      "id": "typescript-vitest",
      "selectors": [
        "tsconfig*.json",
        "packages/*/tsconfig*.json",
        "vitest*.ts",
        "tests/config/**",
        "tests/helpers/**",
        "tests/types/**"
      ],
      "invalidates": ["full-suite", "full-coverage"]
    },
    {
      "id": "governed-close-control",
      "selectors": [
        "law/policy/**",
        "law/schemas/**",
        "law/invariants/**",
        "product/**",
        "work/rounds/**",
        ".github/**"
      ],
      "invalidates": ["governance", "full-suite", "full-coverage"]
    }
  ],
  "nodes": [
    {
      "id": "authority-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/authority/src/**/*.ts",
        "packages/authority/tests/**/*.ts",
        "packages/utils/src/**/*.ts"
      ],
      "depends_on": [],
      "command": ["pnpm", "vitest", "run", "packages/authority/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "cli-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/cli/src/**/*.ts",
        "packages/cli/tests/**/*.ts",
        "packages/{authority,effects-check,evidence,loop,schemas,sensors,skills,spec,utils}/src/**/*.ts"
      ],
      "depends_on": [
        "authority-tests",
        "effects-tests",
        "evidence-tests",
        "loop-tests",
        "schemas-tests",
        "sensors-tests",
        "skills-tests",
        "spec-tests",
        "utils-tests"
      ],
      "command": ["pnpm", "vitest", "run", "packages/cli/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "effects-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/effects-check/src/**/*.ts",
        "packages/effects-check/tests/**/*.ts"
      ],
      "depends_on": [],
      "command": ["pnpm", "vitest", "run", "packages/effects-check/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "evidence-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/evidence/src/**/*.ts",
        "packages/evidence/tests/**/*.ts",
        "packages/{authority,schemas,utils}/src/**/*.ts"
      ],
      "depends_on": ["authority-tests", "schemas-tests", "utils-tests"],
      "command": ["pnpm", "vitest", "run", "packages/evidence/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "loop-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/loop/src/**/*.ts",
        "packages/loop/tests/**/*.ts",
        "packages/{authority,schemas,sensors,spec,utils}/src/**/*.ts"
      ],
      "depends_on": [
        "authority-tests",
        "schemas-tests",
        "sensors-tests",
        "spec-tests",
        "utils-tests"
      ],
      "command": ["pnpm", "vitest", "run", "packages/loop/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "schemas-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/schemas/src/**/*.ts",
        "packages/schemas/scripts/**/*.ts",
        "packages/schemas/tests/**/*.ts",
        "law/schemas/**"
      ],
      "depends_on": [],
      "command": ["pnpm", "vitest", "run", "packages/schemas/tests"],
      "cwd": ".",
      "outputs": [],
