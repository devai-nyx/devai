      ],
      "depends_on": ["authority-tests", "evidence-tests", "schemas-tests", "utils-tests"],
      "command": ["pnpm", "vitest", "run", "packages/spec/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "utils-tests",
      "kind": "test-shard",
      "input_selectors": ["packages/utils/src/**/*.ts", "packages/utils/tests/**/*.ts"],
      "depends_on": [],
      "command": ["pnpm", "vitest", "run", "packages/utils/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "root-tests",
      "kind": "test-shard",
      "input_selectors": [
        "tests/**/*.test.ts",
        "tests/helpers/**",
        "packages/*/src/**/*.ts",
        "scripts/**/*.mjs"
      ],
      "depends_on": ["cli-tests", "skills-tests"],
      "command": ["pnpm", "vitest", "run", "tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "governance",
      "kind": "gate",
      "input_selectors": [
        "law/**",
        "product/**",
        "work/rounds/**",
        "work/audit/**",
        "record/**",
        "tests/**",
        "packages/**"
      ],
      "depends_on": ["full-suite"],
      "command": ["pnpm", "run", "ci:governance"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "full-suite",
      "kind": "fallback",
      "input_selectors": [
        "packages/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.ts",
        "law/**",
        "product/**",
        "work/rounds/**",
        ".github/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "vitest*.ts"
      ],
      "depends_on": [],
      "command": ["pnpm", "vitest", "run"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "full-coverage",
      "kind": "fallback",
      "input_selectors": [
        "packages/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.ts",
        "law/policy/thresholds.json",
        "law/policy/round-close-controls.json",
        "work/rounds/R-0007/affected-test-graph.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "vitest*.ts"
      ],
      "depends_on": ["full-suite"],
      "command": ["pnpm", "run", "test:coverage:t1-t3"],
      "cwd": ".",
      "outputs": [
        "scratch/coverage/t1-t3/coverage-summary.json",
        "scratch/coverage/t1-t3/coverage-final.json",
        "scratch/coverage/t1-t3/subprocess-v8/**"
      ],
      "coverage_mode": "whole-only"
    }
  ],
  "fallbacks": {
    "unknown_dependency": "full-suite",
    "dynamic_import": "full-suite",
    "incomplete_population": "full-suite"
  },
  "coverage": {
    "node": "full-coverage",
    "mode": "whole-only",
    "partial_merge": "forbidden"
  },
  "authoritative_gates": [
    {
      "gate_id": "formatting",
      "execution": "policy-command-exactly-once-per-cold-pass",
      "equivalent_node": null,
      "boundary": "exact-head-clean-no-write-equivalent"
    },
    {
