      "command": ["pnpm", "vitest", "run", "packages/sensors/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
      "id": "skills-tests",
      "kind": "test-shard",
      "input_selectors": [
        "packages/skills/src/**/*.ts",
        "packages/skills/scripts/**/*.ts",
        "packages/skills/tests/**/*.ts",
        "packages/{authority,loop,schemas,sensors,spec,utils}/src/**/*.ts"
      ],
      "depends_on": [
        "authority-tests",
        "loop-tests",
        "schemas-tests",
        "sensors-tests",
        "spec-tests",
        "utils-tests"
      ],
      "command": ["pnpm", "vitest", "run", "packages/skills/tests"],
      "cwd": ".",
      "outputs": [],
      "coverage_mode": "none"
    },
    {
