  "values": {
    "stack": {
      "primary": ["nestjs", "angular", "postgres"],
      "resolved_stack_count": 1,
      "additional_stack_source": "F5 stack-adapter packs"
    },
    "triage_routes": {
      "plant_bug": "engineer",
      "sensor_error": "inspector",
      "policy_issue": "harness_review",
      "reference_gap": "rgr"
    },
    "cycles": {
      "A": {
        "checks": ["typecheck", "lint", "affected-unit"],
        "iteration_advance": false
      },
      "B": {
        "checks": ["full-hard-gate-task-scope"],
        "iteration_advance": true
      },
      "C": {
        "checks": ["full-scorecard", "soft-gates", "auditor-regeneration"],
        "runs_per_merge": 1
      }
    },
    "hard_gate": {
      "required": [
        "affected-typecheck",
        "lint-errors-zero",
        "affected-build",
        "assigned-tests",
        "empty-database-migrations",
        "contract-validation",
        "generated-byte-identity",
        "inventory-regeneration",
        "test-weakening-policy"
      ]
    },
    "soft_gate": {
      "rubrics": [
        "spec-coherence",
        "plant-idiomaticity",
        "test-depth",
        "spec-test-traceability",
        "mutation-kill-rate-when-applicable"
      ],
      "evaluator_must_be_independent": true,
      "thresholds": "law/policy/thresholds.json"
    },
    "iteration": {
      "supported_default_attempts": 1,
      "experimental_default_tier_attempts": 3,
      "experimental_bumped_tier_attempts": 1,
      "exhausted_status": "experimental_blocked"
    },
    "escalation": {
      "branch_prefix": "escalated/",
      "preserve_recoverable_work": true,
      "release_locks": true,
      "automatic_replacement": false,
      "database_disposal_requires_evidence_retention": true
    },
    "rgr": {
      "branch_prefix": "rgr/",
      "task_status": "rgr-pending",
      "release_locks": true,
      "destroy_worktree": true,
      "human_requeue_required": true
    },
    "model_routing": {
      "steps": [
        "different-family-same-context",
        "larger-same-family",
        "larger-alternate-family",
        "human"
      ],
      "supported_invocation": "human-initiated"
    },
    "orchestration": {
      "triplet_order": ["architect", "inspector", "engineer"],
      "merge_order": ["architect", "inspector", "engineer"],
      "mandatory_checkpoint": "task-completion"
    },
    "locks": {
      "key": ["substrate", "module"],
      "denial_action": "requeue-with-priority-bump",
      "repeated_denial_action": "human-review"
    },
    "worktrees": {
      "root": ".devai/worktrees",
      "active_non_adopted_cap": 3,
      "human_adopted_cap_exempt": true,
      "lockfile_mismatch": "fresh-install"
    },
    "repository": {
      "integration_branch": "main"
    },
    "test_quarantine": {
      "trace_flags": ["flaky", "quarantine"],
      "temporary": true,
      "eventual_broken_state": "hard-gate-fail"
    },
    "auditor": {
      "after_merge": true,
      "human_on_demand": true,
      "pre_batch_on_demand": true,
      "timer": false
    },
    "result_vocabulary": {
      "scorecard_uncertain": "unknown",
      "triage_uncertain": "inconclusive",
      "soft_gate_uncertainty": "confidence-interval"
    },
    "upgrade": {
      "action": "adopt upgrade",
      "client_explicit": true,
      "implicit": false,
      "history_preserved": true
    }
  }
}
