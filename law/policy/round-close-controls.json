{
  "schemaVersion": "4.0.0",
  "policy_id": "generic-round-close-controls",
  "policy_version": "4.0.0",
  "decision_id": "DII-248",
  "schemas": {
    "round_profile": "law/schemas/round-close-profile.schema.json",
    "affected_test_graph": "law/schemas/affected-test-graph.schema.json",
    "task_freshness": "law/schemas/task-freshness.schema.json",
    "semantic_obligations": "law/schemas/review-obligations.schema.json",
    "current_claims": "law/schemas/current-claims.schema.json",
    "candidate_manifest": "law/schemas/candidate-manifest.schema.json",
    "round_convergence": "law/schemas/round-convergence.schema.json",
    "reviewer_binding": "law/schemas/reviewer-binding.schema.json",
    "prior_finding_registry": "law/schemas/prior-finding-registry.schema.json",
    "review_state": "law/schemas/review-state.schema.json",
    "review_transport": "law/schemas/review-transport.schema.json",
    "review_repair_evidence": "law/schemas/review-repair-evidence.schema.json",
    "review_scope": "law/schemas/review-scope-manifest.schema.json",
    "review_result": "law/schemas/review-result.schema.json"
  },
  "profile_discovery": {
    "path_template": "work/rounds/{round}/close-control-profile.json",
    "round_pattern": "^R-[0-9]{4}$",
    "profile_required": true,
    "implicit_round_forbidden": true
  },
  "identities": {
    "fields": ["implementation_subject", "review_candidate", "published_head"],
    "required_kind": "commit",
    "governed_range": "exact-declared-base-to-published-head",
    "fixed_windows_forbidden": true,
    "publishability": "candidate-only-no-alternates",
    "candidate_change_invalidates": [
      "convergence",
      "claims",
      "rehearsal",
      "candidate_manifest",
      "review_scope",
      "review_result",
      "publication_standing"
    ]
  },
  "role_paths": {
    "Architect": ["law/**", "work/rounds/**", "docs/**"],
    "Owner": ["product/**"],
    "Engineer": [
      ".devai/config/**",
      ".devai/pin/**",
      ".github/**",
      "packages/**",
      "scripts/**",
      "*.json",
      "*.yml",
      "*.yaml",
      "eslint.config.*",
      "tsconfig.*"
    ],
    "Inspector": ["tests/**", "**/tests/**", "**/*.test.ts", "**/*.spec.ts"],
    "Auditor": ["work/audit/**"],
    "Machine": ["record/**"]
  },
  "projections": [
    {
      "id": "action-registry",
      "command": ["pnpm", "run", "action-registry:check"],
      "sources": ["law/policy/action-registry.json"],
      "outputs": [
        "packages/cli/src/generated/action-registry.ts",
        "packages/effects-check/src/generated/action-catalog.ts",
        "packages/sensors/src/generated/action-kinds.ts"
      ]
    },
    {
      "id": "trace",
      "command": ["pnpm", "run", "trace:check"],
      "sources": ["law/invariants/**/*.json", "tests/**/*.ts", "packages/**/tests/**/*.ts"],
      "outputs": ["law/trace.json"]
    },
    {
      "id": "repository-references",
      "command": ["pnpm", "run", "repository-reference:check"],
      "sources": ["**/*"],
      "outputs": ["work/rounds/R-0002/repository-reference-triage.json"]
    },
    {
      "id": "round-close-policy-materialization",
      "command": ["node", "scripts/run-round-close-controls.mjs", "policy-check"],
      "sources": [
        "law/policy/round-close-controls.json",
        "law/schemas/round-close-profile.schema.json"
      ],
      "outputs": [".devai/config/round-close-controls.json"]
    }
  ],
  "freshness": {
    "policy_version": "2.0.0",
    "graph_from_round_profile": true,
    "state_root_template": ".devai/state/round-runs/{round}/close/freshness",
    "cache_write": "atomic-rename",
    "local_pass_cache_trusted": true,
    "remote_pass_cache_trusted": false,
    "remote_environment_indicators": ["CI", "GITHUB_ACTIONS"],
    "plan_outcomes": ["EXECUTE", "REUSE_FRESH", "BLOCKED"],
    "reusable_result": "EXECUTED_PASS",
    "non_reusable_results": ["EXECUTED_FAIL", "BLOCKED", "MALFORMED", "TAMPERED"],
    "task_key_components": [
      "task-id",
      "argv",
      "cwd",
      "complete-transitive-input-manifest",
      "dependency-keys",
      "required-output-digests",
      "environment-digest",
      "toolchain-digest",
      "policy-digest",
      "graph-digest"
    ],
    "environment_allowlist": [
      { "name": "CI", "mode": "value-sha256" },
      { "name": "GITHUB_ACTIONS", "mode": "value-sha256" },
      { "name": "NODE_ENV", "mode": "value-sha256" },
      { "name": "DATABASE_URL", "mode": "presence" },
      { "name": "DEVAI_TEST_DATABASE_URL", "mode": "presence" }
    ],
    "toolchain": [
      { "id": "node", "argv": ["node", "--version"] },
      { "id": "pnpm", "argv": ["pnpm", "--version"] },
      { "id": "vitest", "argv": ["pnpm", "exec", "vitest", "--version"] },
      { "id": "typescript", "argv": ["pnpm", "exec", "tsc", "--version"] },
      { "id": "git", "argv": ["git", "--version"] }
    ],
    "unknown_dependency": "execute-full-suite-fallback",
    "dynamic_import_ambiguity": "execute-full-suite-fallback",
    "incomplete_population": "execute-full-suite-fallback",
    "dirty_untracked_deleted_renamed_inputs": "include-content-state-in-plan",
    "timestamp_only_change": "does-not-invalidate-identical-bytes",
    "coverage_reuse": "whole-identical-inputs-dependencies-environment-toolchain-and-outputs-only",
    "partial_coverage_merge": "forbidden"
  },
  "review_scope": {
    "policy_version": "3.0.0",
    "obligations_from_round_profile": true,
    "claims_from_round_profile": true,
    "claims_digest_source": "profile-runtime-materialized-claims",
    "exact_range": "declared-base-to-candidate",
    "topic_sources": [
      "semantic-obligation",
      "changed-path",
      "active-control",
      "current-claim",
      "previous-finding-class",
      "candidate-identity",
      "convergence-evidence"
    ],
    "markdown_requirement_scan": "unregistered-obligation-lint-only",
    "dispositions": ["RECHECKED_PASS", "RECHECKED_FAIL", "REUSED_FRESH_PASS", "BLOCKED"],
    "exactly_once": true,
    "unchanged_topic_omission": "invalid",
    "unchanged_reuse_requires_independent_digest_and_evidence_recheck": true,
    "reused_topic_requires_current_task_keys": true,
    "reused_topic_recomputation": [
      "current-input-manifest",
      "referenced-evidence-manifest",
      "referenced-evidence-digest",
      "every-required-current-task-key"
    ],
    "changed_topic_reuse_forbidden": true,
    "previous_finding_classes_mandatory": true,
    "structured_result_required": true,
    "finding_ids_globally_unique_across_json_or_jsonl": true,
    "terminal_record_required": true,
    "truncated_or_malformed_result": "invalid-never-pass"
  },
  "claims": {
    "policy_version": "2.0.0",
    "registry_from_round_profile": true,
    "registry_is_declaration_only": true,
    "validation_source": "profile-runtime-materialized-claims",
    "volatile_numeric_prose": "generated-or-checked-only",
    "candidate_or_source_change": "invalidate",
    "required_bindings": [
      "producer-command",
      "deterministic-extractor",
      "candidate-sha",
      "complete-source-manifest",
      "source-digest",
      "producer-output-digest",
      "extracted-value",
      "value-digest",
      "rendered-location-content-digests",
      "per-claim-structured-rendered-markers",
      "per-location-verification-digests"
    ],
    "substring_match_forbidden": true,
    "rendered_marker_must_equal_claim_id": true,
    "rendered_proofs_exactly_match_declared_locations": true,
    "source_manifest_exactly_matches_resolved_sources": true,
    "complete_ledger_atomic": true,
    "pre_review_post_publication_claim": "authenticated-deferred-declaration",
    "post_publication_receipt": "separate-self-digested-ledger-bound-to-pre-review-digest",
    "ledger_self_digest": "sha256-canonical-body-with-claims-digest-omitted",
    "materialization_order": [
      "candidate-primitive-identity",
      "convergence",
      "pure-review-topic-count",
      "materialized-claims",
      "candidate-manifest",
      "review-scope",
      "post-publication-claims-receipt"
    ],
    "scope-dependent-claim-producer": "forbidden"
  },
  "review_state_machine": {
    "policy_version": "2.0.0",
    "states": [
      "DRAFT",
      "PREFLIGHT_GREEN",
      "CANDIDATE_FROZEN",
      "CYCLE_1_ACTIVE",
      "REPAIR_REQUIRED",
      "NEW_CANDIDATE_FROZEN",
      "CYCLE_2_ACTIVE",
      "PASS",
      "ESCALATION_REQUIRED",
      "REVIEW_TRANSPORT_BLOCKED"
    ],
    "substantive_cycle_budget": 2,
    "cycle_one": "exhaustive-complete-population",
    "repair": "one-role-pure-complete-class-phase",
    "cycle_two": "exhaustive-regenerated-complete-population",
    "cycle_three": "mechanically-forbidden",
    "cycle_two_failure": "ESCALATION_REQUIRED",
    "transport_retry_budget_per_cycle": 1,
    "second_invalid_transport": "REVIEW_TRANSPORT_BLOCKED",
    "forced_pass": false,
    "allowed_transitions": {
      "DRAFT": ["PREFLIGHT_GREEN"],
      "PREFLIGHT_GREEN": ["CANDIDATE_FROZEN", "NEW_CANDIDATE_FROZEN"],
      "CANDIDATE_FROZEN": ["CYCLE_1_ACTIVE"],
      "CYCLE_1_ACTIVE": ["PASS", "REPAIR_REQUIRED", "REVIEW_TRANSPORT_BLOCKED"],
      "REPAIR_REQUIRED": ["PREFLIGHT_GREEN"],
      "NEW_CANDIDATE_FROZEN": ["CYCLE_2_ACTIVE"],
      "CYCLE_2_ACTIVE": ["PASS", "ESCALATION_REQUIRED", "REVIEW_TRANSPORT_BLOCKED"]
    },
    "state_identity": [
      "round",
      "base",
      "candidate",
      "tree",
      "profile-digest",
      "policy-digest",
      "candidate-manifest-digest",
      "review-scope-digest",
      "reviewer-binding-digest"
    ],
    "authenticated_chain": [
      "state-self-digest",
      "prior-state-digest",
      "candidate-manifest-digest",
      "review-scope-digest",
      "review-result-digest",
      "transport-digest",
      "repair-evidence-digest"
    ],
    "cycle_two_requires": [
      "authenticated-cycle-one-failure",
      "exact-prior-candidate-and-manifests",
      "distinct-regenerated-candidate",
      "complete-class-repair-evidence"
    ],
    "transition_guards": {
      "NEW_CANDIDATE_FROZEN": "requires-authenticated-REPAIR_REQUIRED-in-history",
      "CYCLE_2_ACTIVE": "requires-authenticated-complete-class-repair-and-distinct-candidate"
    },
    "terminal_states": ["PASS", "ESCALATION_REQUIRED", "REVIEW_TRANSPORT_BLOCKED"],
    "transport_identity": ["round", "cycle", "candidate", "manifest-digest", "reviewer"],
    "transport_guards": {
      "attempt_one_previous_digest": "null",
      "attempt_two_previous_digest": "authenticated-attempt-one",
      "identity_change_between_attempts": "forbidden",
      "transport_binds": "state-before-only",
      "subsequent_state_transition_consumes_transport_digest": true
    },
    "repair_evidence_guards": {
      "failed_classes": "exactly-equal-prior-result-failed-class-population",
      "repaired_instances": "exactly-equal-each-class-affected-instances",
      "new_candidate": "distinct-and-descends-from-prior-candidate"
    }
  },
  "reviewer_binding": {
    "source": "per-round-profile-plus-complete-structured-active-owner-mandate-census",
    "schema_marker": "devai_reviewer_binding",
    "census_participation": "complete-schema-valid-marker-only",
    "marker_mandate_id_and_status_must_match_container": true,
    "census_glob": "product/owner-mandates/OM-*.md",
    "preparation_allows_unbound": true,
    "preparation_diagnostic": "ENTRY_BLOCKED_REVIEWER_UNBOUND",
    "entry_requires_exactly_one_active_binding": true,
    "missing_inactive_ambiguous_or_conflicting": "entry-blocked",
    "silent_fallback": "forbidden",
    "substitution_invalidates_prior_pass": true
  },
  "convergence": {
    "schema": "law/schemas/round-convergence.schema.json",
    "passes": 2,
    "second_pass": "no-write-clean",
    "authoritative_population": "all-policy-command-ids-exactly-once",
    "affected_graph_role": "supplemental-local-impact-population",
    "pass_boundaries": {
      "head": "exact-and-stable",
      "tree": "clean-before-and-after",
      "second_pass_writes": "forbidden",
      "semantic_equivalence": "required"
    },
    "remote_mode": "execute-complete-authoritative-population",
    "candidate_cross_binding": {
      "candidate_requires_convergence_digest": true,
      "shared_candidate_identity_digest": true,
      "fallback_evidence": "forbidden"
    },
    "evidence_validation": [
      "self-digest",
      "exact-base-candidate-tree-policy-profile",
      "authoritative-gate-ids-exactly-once-per-pass",
      "stable-head-and-clean-boundaries",
      "pass-two-zero-writes",
      "equal-semantic-population-digests"
    ],
    "commands": [
      { "id": "formatting", "argv": ["pnpm", "exec", "prettier", "--check", "."] },
      { "id": "preparation", "argv": ["pnpm", "run", "devai:prepare"] },
      { "id": "action-registry", "argv": ["pnpm", "run", "action-registry:check"] },
      { "id": "trace", "argv": ["pnpm", "run", "trace:check"] },
      { "id": "repository-references", "argv": ["pnpm", "run", "repository-reference:check"] },
      {
        "id": "materializations",
        "argv": ["node", "scripts/run-round-close-controls.mjs", "policy-check"]
      },
      { "id": "diff-check", "argv": ["git", "diff", "--check"] },
      { "id": "ordinary", "argv": ["pnpm", "vitest", "run"] },
      { "id": "stage1", "argv": ["pnpm", "run", "ci:stage1"] },
      { "id": "stage2", "argv": ["pnpm", "run", "ci:stage2"] },
      { "id": "t4", "argv": ["pnpm", "run", "test:t4"] },
      { "id": "t5", "argv": ["pnpm", "run", "test:t5"] },
      { "id": "t6", "argv": ["pnpm", "run", "test:t6"] },
      { "id": "changesets", "argv": ["pnpm", "run", "ci:changesets"] },
      { "id": "coverage", "argv": ["pnpm", "run", "test:coverage:t1-t3"] },
      { "id": "governance", "argv": ["pnpm", "run", "ci:governance"] }
    ]
  },
  "rehearsal": {
    "schema_path": "law/schemas/phase-closure.schema.json",
    "verb_path": "packages/cli/src/commands/phase/index.ts",
    "closure_path_glob": "record/proofs/compliance/closures/PC-*.json",
    "candidate_only_clone": "bundle-single-branch-no-alternates",
    "command": ["node", "packages/cli/dist/bin.js", "govern", "phase", "close"],
    "range_check": ["node", "scripts/check-governed-sequencing.mjs"]
  },
  "semantic_assertions": {
    "authentication": "sha256-of-canonical-json-with-own-self-digest-field-omitted",
    "population_sources": [
      "law/**/*.json",
      "product/**/*.json",
      "packages/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.ts"
    ],
    "fixed_counts_forbidden": true,
    "self_comparisons_forbidden": true,
    "named_file_only_forbidden": true,
    "mirror_pairs": [
      {
        "source": "law/policy/round-close-controls.json",
        "mirror": ".devai/config/round-close-controls.json"
      }
    ]
  }
}
