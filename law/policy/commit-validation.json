          "cold-sentinel-restores-the-complete-active-floor",
          "workflow-security-dag-concurrency-and-telemetry-contracts",
          "full-local-vitest-and-coverage-regression"
        ],
        "prohibited_claims": [
          "paired-benchmark-complete",
