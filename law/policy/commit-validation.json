          "R7-F018-closed-as-activation"
        ]
      }
    },
    "activation_owner": "R-0008-under-separate-entry-and-review-authority",
    "sample_states": ["cold-miss", "warm-hit"],
    "minimum_runs_per_baseline_per_state": 3,
    "minimum_runs_per_candidate_per_state": 3,
    "same_exact_candidate": true,
    "same_runner_class": true,
    "semantic_population_equality_first": true,
    "all_attempted_runs_recorded": true,
    "failed_cancelled_incomplete_or_population_mismatched_runs": "excluded-from-median-but-retained-in-evidence",
    "timings_ms": [
      "queue",
      "setup",
      "install",
      "jobs",
      "gates",
      "artifact-verification",
      "critical-path"
    ],
    "speed_threshold": {
      "candidate_median_lower_in_at_least_one_state": true,
      "maximum_other_state_regression_percentage": 2,
      "alternative": "separately-proved-security-or-operability-benefit"
    },
    "remain_disabled_when": [
      "semantic-population-mismatch",
      "sample-incomplete",
      "runner-class-mismatch",
      "no-positive-median-critical-path-saving",
      "threshold-regression",
      "unproved-security-or-operability-alternative"
    ],
    "evidence_path": null,
    "evidence_path_binding": "R-0008-entry-and-review-authority-required"
  },
  "rollback": {
    "triggers": [
      "CLASSIFIER_FALSE_NEGATIVE",
      "semantic-population-mismatch",
      "cache-changes-verdict-or-population",
      "artifact-used-as-pass",
      "mutable-action-reference",
      "permission-widening",
      "authoritative-run-cancelled-or-replaced",
      "coverage-threshold-or-population-regression"
    ],
    "effect": "disable-narrowing-and-restore-exact-active-cold-command-population",
    "repair": "governed-red-first-complete-defect-class-repair",
    "silent_reenablement": "forbidden"
  },
  "invariants": {
    "author_can_lower_class": false,
    "strictest_class_wins": true,
    "unknown_widens": true,
    "every_class_runs_diff_check": true,
    "cache_grants_pass": false,
    "artifact_grants_pass": false,
    "cold_lane_uses_devai_result_reuse": false,
    "coverage_partial_merge": false,
