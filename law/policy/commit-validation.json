{
  "schemaVersion": "1.0.0",
  "policy_id": "commit-validation",
  "policy_version": "1.0.0",
  "round": "R-0007",
  "status": "implemented-disabled-pending-r0008-activation-authority",
  "authority": "Architect",
  "sources": [
    "product/owner-mandates/OM-021.md",
    "product/owner-mandates/OM-019.md",
    "product/owner-mandates/OM-022.md",
    "work/rounds/R-0007/plan.md",
    "law/adr/ADR-024-r0007-ci-validation.md",
    "law/policy/round-close-controls.json",
    "work/rounds/R-0007/affected-test-graph.json"
  ],
  "implementation": {
    "command": [
      "node",
      "scripts/derive-commit-validation-plan.mjs",
      "--repo-root",
      "<repo-root>",
      "--round",
      "R-0007",
      "--base",
      "<exact-base>",
      "--candidate",
      "<exact-candidate>",
      "--json"
    ],
    "script": "scripts/derive-commit-validation-plan.mjs",
    "plan_schema": "law/schemas/commit-validation-plan.schema.json",
    "optimisation_evidence_schema": "law/schemas/ci-optimisation-evidence.schema.json",
    "author_class_argument": "forbidden",
    "author_override_diagnostic": "COMMIT_VALIDATION_CLASS_UNDERBOUND"
  },
  "exact_inputs": {
    "diff": {
      "argv": [
        "git",
        "diff",
        "--name-status",
        "-z",
        "-M",
        "--find-renames",
        "<exact-base>",
        "<exact-candidate>"
      ],
      "record_format": "status-aware-nul",
      "statuses": ["A", "M", "D", "T", "R100", "C100"],
      "rename_semantics": "retain-preimage-and-postimage-in-one-linked-record",
      "non_exact_similarity": "record-as-delete-plus-add-and-widen",
      "symlink_semantics": "bind-path-mode-object-and-link-target-without-dereference",
      "dirty_worktree_authority": "none-candidate-objects-only"
    },
    "affected_test_graph": "work/rounds/R-0007/affected-test-graph.json",
    "command_closure_policy": "law/policy/round-close-controls.json",
    "commit_validation_policy": "law/policy/commit-validation.json",
    "schema_population": "law/schemas/**",
    "materialization_sources": "law/policy/round-close-controls.json#/projections",
    "generated_source_edges": "law/policy/round-close-controls.json#/projections",
    "governance_sources": [
      "law/policy/governed-sequencing.json",
      "scripts/check-governed-sequencing.mjs",
      "scripts/check-governed-sha-references.mjs",
      "scripts/check-implementation-path-manifest.mjs",
      "scripts/check-round-artifact-uniqueness.mjs"
    ],
    "package_scripts": "candidate:package.json#/scripts",
    "workspace_packages": "candidate:pnpm-workspace.yaml",
    "workflows": "candidate:.github/workflows/*.{yml,yaml}",
    "toolchain_probes": "law/policy/round-close-controls.json#/freshness/toolchain",
    "commit_resolution": "base-and-candidate-must-each-resolve-to-one-literal-40-hex-commit",
    "ancestry": "exact-base-must-be-an-ancestor-of-exact-candidate",
    "candidate_loading": "policy-graph-workflows-package-scripts-schemas-and-governance-controls-from-candidate-objects-never-mutable-worktree",
    "identity_rule": "every-input-is-candidate-blob-or-explicit-git-virtual-source-with-sha256"
  },
  "class_order": ["governance-text", "law-and-schema", "runtime-and-tests", "candidate-and-close"],
  "derivation": {
    "strictest_rule": "maximum-class-order-index-across-every-changed-path-and-derived-dependency",
    "mixed_commit": "strictest-class-wins",
    "unknown_path": "candidate-and-close",
    "unknown_dependency": "retain-derived-class-and-select-complete-cold-ordinary-plus-coverage-population",
    "dynamic_dependency": "retain-derived-runtime-class-and-select-complete-cold-ordinary-plus-coverage-population",
    "incomplete_closure": "widen-never-narrow",
    "deletion": "classify-preimage-and-every-dependent",
    "rename": "classify-preimage-postimage-and-union-dependents",
    "symlink": "classify-link-entry-and-target-without-following-outside-repository",
    "generated_source": "select-generator-source-output-materialization-and-dependent-tests",
    "workflow_indirection": "follow-local-reusable-workflows-package-scripts-and-literal-local-actions",
    "unresolved_workflow_indirection": "runtime-and-tests-with-complete-cold-ordinary-plus-coverage-population",
    "diagnostics": [
      "COMMIT_VALIDATION_CLASS_UNDERBOUND",
      "DYNAMIC_DEPENDENCY_AMBIGUOUS",
      "COMMIT_VALIDATION_CLOSURE_INCOMPLETE",
      "COMMIT_VALIDATION_PATH_UNKNOWN",
      "CLASSIFIER_FALSE_NEGATIVE"
    ]
  },
  "classification_rules": [
    {
      "class": "candidate-and-close",
      "selectors": [
        "scripts/derive-commit-validation-plan.mjs",
        "law/policy/commit-validation.json",
        "law/schemas/commit-validation-plan.schema.json",
        "work/rounds/R-0007/affected-test-graph.json"
      ],
      "derived_triggers": [
        "classifier-policy-or-graph-implementation",
        "classifier-or-sentinel-activation",
        "classifier-disablement-or-reenablement",
        "trust-root-activation",
        "frozen-candidate",
        "convergence",
        "round-close",
        "release-eligibility"
      ],
      "reason": "Classifier-owning and authority-closing changes bootstrap under the complete active cold profile."
    },
    {
      "class": "runtime-and-tests",
      "selectors": [
        "packages/**",
        "scripts/**",
        "tests/**",
        ".github/workflows/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "vitest*.ts",
        "eslint.config.*",
        ".prettier*"
      ],
      "derived_triggers": [
        "workspace-tooling",
        "package-script",
        "workflow-or-local-action",
        "test-or-test-configuration",
        "runtime-generated-output"
      ],
      "reason": "Executable, workflow, test, and tooling changes require static and complete mechanically affected runtime closure."
    },
    {
      "class": "law-and-schema",
      "selectors": ["law/**", ".devai/config/**", ".devai/pin/**", "record/**"],
      "derived_triggers": [
        "policy-or-schema",
        "registry",
        "canonical-descriptor",
        "materialization-source-or-output"
      ],
      "reason": "Normative machine law and its materializations require schema, policy, trace, generation, governance, and affected-test proof."
    },
    {
      "class": "governance-text",
      "selectors": [
        "product/**",
        "work/rounds/**/*.md",
        "work/audit/**/*.md",
        "docs/**",
        "README.md",
        "CONTRIBUTING.md",
        "SECURITY.md"
      ],
      "derived_triggers": [
        "non-executable-owner-mandate",
        "non-executable-round-plan-or-prompt",
        "non-executable-documentation"
      ],
      "reason": "Non-executable governance and documentation use exact changed-file and reference checks without unconditional full Vitest."
    }
  ],
  "global_commands": [
    {
      "id": "diff-check",
      "argv": ["git", "diff", "--check", "<exact-base>", "<exact-candidate>"],
      "cwd": ".",
      "reason": "Every class retains exact-range whitespace and conflict-marker validation."
    },
    {
      "id": "changed-formatting",
      "argv": ["pnpm", "exec", "prettier", "--check", "<changed-format-supported-paths...>"],
      "cwd": ".",
      "reason": "Formatting is limited to the exact changed supported population outside the cold class."
    },
    {
      "id": "preparation",
      "argv": ["pnpm", "run", "devai:prepare"],
      "cwd": ".",
      "reason": "Generated law and production binary inputs must be current before law or runtime validation."
    },
    {
      "id": "lint",
      "argv": ["pnpm", "run", "lint"],
      "cwd": ".",
      "reason": "Runtime and test changes retain repository static linting."
    },
    {
      "id": "typecheck",
      "argv": ["pnpm", "run", "typecheck"],
      "cwd": ".",
      "reason": "Runtime and test changes retain repository type checking."
    },
    {
      "id": "ordinary",
      "argv": ["pnpm", "vitest", "run"],
      "cwd": ".",
      "reason": "Complete ordinary fallback for broad, dynamic, or incomplete affected-test closure."
    },
    {
      "id": "coverage",
      "argv": ["pnpm", "run", "test:coverage:t1-t3"],
      "cwd": ".",
      "reason": "Coverage is indivisible and runs whole when any relevant impact is selected or unresolved."
    },
    {
      "id": "workflow-contracts",
      "argv": ["pnpm", "run", "ci:workflows"],
      "cwd": ".",
      "reason": "Workflow changes retain immutable pins, permissions, cache, DAG, matrix, concurrency, and artifact boundaries."
    },
    {
      "id": "governance",
      "argv": ["pnpm", "run", "ci:governance"],
      "cwd": ".",
      "reason": "Authority, sequencing, implementation-path, reference, and forbidden-action controls remain affected gates."
    },
    {
      "id": "policy-check-adrs",
      "argv": [
        "node",
        "packages/cli/dist/bin.js",
        "policy",
        "check",
        "adrs",
        "--repo-root",
        ".",
        "--format",
        "json"
      ],
      "cwd": ".",
      "reason": "Changed ADRs require frontmatter, mandatory-section, lifecycle, filename, and sequential-roster validation."
    },
    {
      "id": "policy-check-schemas",
      "argv": [
        "node",
        "packages/cli/dist/bin.js",
        "policy",
        "check",
        "schemas",
        "--repo-root",
        ".",
        "--format",
        "json"
      ],
      "cwd": ".",
      "reason": "Schema and schema-consuming policy changes require the complete recursive schema canon."
    },
    {
      "id": "action-registry",
      "argv": ["pnpm", "run", "action-registry:check"],
      "cwd": ".",
      "reason": "Registry sources and generated action materializations remain byte-identical."
    },
    {
      "id": "trace",
      "argv": ["pnpm", "run", "trace:check"],
      "cwd": ".",
      "reason": "Affected invariant and test trace projections remain current."
    },
    {
      "id": "repository-references",
      "argv": ["pnpm", "run", "repository-reference:check"],
      "cwd": ".",
      "reason": "Changed governed references resolve against the exact candidate."
    },
    {
      "id": "round-artifact-uniqueness",
      "argv": ["node", "scripts/check-round-artifact-uniqueness.mjs"],
      "cwd": ".",
      "reason": "Round plans, profiles, authorization, reviewer binding, and runtime roots remain unique."
    },
    {
      "id": "sha-references",
      "argv": ["pnpm", "run", "ci:sha-references"],
      "cwd": ".",
      "reason": "Candidate SHA references remain resolvable or explicitly classified."
    },
    {
      "id": "affected-tests",
      "argv": ["pnpm", "vitest", "run", "<ordered-affected-test-paths...>"],
      "cwd": ".",
      "reason": "Every transitively dependent affected test executes exactly once."
    },
    {
      "id": "affected-tier",
      "argv": ["<exact-argv-from-candidate-command-closure>"],
      "cwd": ".",
      "reason": "Affected tier, DB, workflow, and instrumentation gates retain their candidate command closure."
    }
  ],
  "classes": [
    {
      "id": "governance-text",
      "mandatory_command_ids": ["diff-check", "changed-formatting", "governance"],
      "conditional_command_ids": [
        "policy-check-adrs",
        "policy-check-schemas",
        "trace",
        "repository-references",
        "round-artifact-uniqueness",
        "sha-references"
      ],
      "derived_populations": [
        "frontmatter-and-schema-for-changed-record-types",
        "exact-repository-references",
        "active-authority-census",
        "round-artifact-uniqueness",
        "affected-trace-and-derived-digest-checks"
      ],
      "full_vitest_default": false,
      "widen_when": [
        "executable-content-detected",
        "derived-policy-schema-or-runtime-dependency",
        "unclassified-governed-path"
      ]
    },
    {
      "id": "law-and-schema",
      "mandatory_command_ids": [
        "diff-check",
        "changed-formatting",
        "preparation",
        "policy-check-schemas",
        "governance"
      ],
      "conditional_command_ids": [
        "action-registry",
        "trace",
        "repository-references",
        "round-artifact-uniqueness",
        "sha-references",
        "affected-tests"
      ],
      "derived_populations": [
        "schema-meta-and-canon",
        "policy-validation",
        "action-registry-and-generated-materializations",
        "trace-and-reference-checks",
        "complete-mechanically-affected-tests"
      ],
      "full_vitest_default": false,
      "widen_when": [
        "schema-policy-closure-incomplete",
        "materialization-edge-unresolved",
        "affected-test-closure-incomplete"
      ],
      "widened_command_ids": ["ordinary", "coverage"]
    },
    {
      "id": "runtime-and-tests",
      "mandatory_command_ids": [
        "diff-check",
        "changed-formatting",
        "preparation",
        "lint",
        "typecheck"
      ],
      "conditional_command_ids": [
        "workflow-contracts",
        "affected-tests",
        "affected-tier",
        "coverage"
      ],
      "derived_populations": [
        "complete-affected-test-closure",
        "affected-tier-and-db-gates",
        "workflow-contracts-when-workflow-reachable",
        "whole-coverage-when-coverage-relevant"
      ],
      "full_vitest_default": false,
      "widen_when": [
        "broad-runtime-impact",
        "dynamic-dependency-ambiguity",
        "workflow-or-package-script-indirection-unresolved",
        "affected-test-closure-incomplete"
      ],
      "widened_command_ids": ["ordinary", "coverage"]
    },
    {
      "id": "candidate-and-close",
      "mandatory_command_source": "law/policy/round-close-controls.json#/convergence/commands",
      "mandatory_population": "complete-active-profile-in-declared-order",
      "cold": true,
      "devai_result_reuse": "forbidden",
      "cancellation": "forbidden",
      "literal_independent_execution": "required-where-active-profile-requires"
    }
  ],
  "machine_plan": {
    "required_bindings": [
      "base_sha",
      "candidate_sha",
      "status-aware-changed-paths",
      "derived-dependencies-with-reasons",
      "selected-commands-with-reasons-and-exits",
      "omitted-commands-with-reasons-and-null-exits",
      "round-close-policy-path-and-digest",
      "commit-validation-policy-path-and-digest",
      "affected-test-graph-path-and-digest",
      "toolchain-identities",
      "diff-command-and-digest",
      "complete-closure-input-paths-and-digests",
      "self-digest"
    ],
    "self_digest": "sha256-canonical-json-with-plan-digest-field-omitted",
    "pending_exit": null,
    "omission_without_reason": "invalid",
    "unknown_or_duplicate_command": "invalid"
  },
  "sentinel": {
    "events": ["schedule", "push-main"],
    "candidate_binding": "same-exact-candidate-for-predicted-and-complete-cold-observed",
    "predicted_population": "classifier-selected-command-ids",
    "observed_population": "law/policy/round-close-controls.json#/convergence/commands",
    "comparison_order": "semantic-population-before-verdict-and-timing",
    "false_negative": "any-cold-failing-command-predicted-omitted",
    "diagnostic": "CLASSIFIER_FALSE_NEGATIVE",
    "current_observation_effect": "narrowing-disabled-and-complete-fallback-plan-emitted",
    "fallback_class": "candidate-and-close",
    "fallback_command_source": "law/policy/round-close-controls.json#/convergence/commands",
    "fallback_exit": 1,
    "missing_stale_malformed_or_unauthenticated_health": "narrowing-disabled",
    "cross_run_artifact_authority": "none-until-r0008-authentication",
    "persistent_disablement": "any-sentinel-failure-or-incomplete-sentinel-history-since-the-governed-activation-version-widens-to-the-full-floor",
    "negative_only_external_signal": "a-read-only-failure-or-missing-history-may-disable-but-no-success-conclusion-artifact-cache-or-summary-may-enable-or-satisfy-a-gate",
    "reenablement": [
      "governed-complete-defect-class-repair",
      "new-commit-validation-policy-version",
      "complete-same-candidate-cold-sentinel-with-zero-false-negatives",
      "paired-evidence-revalidated"
    ]
  },
  "activation": {
    "initial_state": "disabled-pending-implementation-paired-benchmark-and-proved-rollback",
    "current_state": "disabled-pending-r0008-activation-authority",
    "acceptance_boundaries": {
