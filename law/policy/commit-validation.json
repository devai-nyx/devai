      "B7": {
        "claim": "implemented-disabled-foundation-and-local-round-close",
        "paired_benchmark_required": false,
        "required_state": "disabled-pending-r0008-activation-authority",
        "required_proofs": [
          "complete-feature-census-and-one-to-one-dispositions",
          "cache-and-artifact-have-no-pass-authority",
          "classifier-fails-closed-and-unknown-widens",
          "cold-sentinel-restores-the-complete-active-floor",
