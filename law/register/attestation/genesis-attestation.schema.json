{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/genesis-attestation.schema.json",
  "title": "Genesis attestation",
  "description": "The single crossing point between predecessor and successor. Carries data, never authority; immutable once ratified \u2014 correction is a new decision, never an edit.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record": {
      "$ref": "common-defs.schema.json#/$defs/id_genesis"
    },
    "ratified": {
      "anyOf": [
        {
          "$ref": "common-defs.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_url": {
          "const": "https://github.com/devai-nyx/devai-original",
          "description": "Frozen predecessor repository. The successor repository is never a valid self-reference."
        },
        "final_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "final_tree_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_chain_head_sha256": {
          "anyOf": [
            {
              "$ref": "common-defs.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "closing_decision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^D-[0-9]+$"
            },
            {
              "type": "null"
            }
          ],
          "$comment": "Bound at R-Omega to the next-free predecessor number. Was const D-189; predecessor numbering reached D-195 at the R30 close (PC-0018) before the terminal decision was authored."
        },
        "closing_pc_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "required": [
        "repo_url",
        "final_commit_sha",
        "final_tree_sha",
        "evidence_chain_head_sha256",
        "closing_decision",
        "closing_pc_record",
        "frozen"
      ]
    },
    "absorption_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "common-defs.schema.json#/$defs/sha256"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "documents"
      ]
    },
    "imported_law": {
      "type": "object"
    },
    "imported_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string"
          },
          "predecessor_records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "attested-historical",
              "must-re-earn"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "claim",
          "predecessor_records",
          "status"
        ]
      }
    },
    "tombstones": {
      "type": "object"
    },
    "identifier_map": {
      "type": "array"
    },
    "package_continuity": {
      "type": "object"
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "record",
    "predecessor",
    "imported_evidence",
    "non_claims"
  ],
  "examples": [
    {
      "record": "GEN-0001",
      "ratified": null,
      "predecessor": {
        "repo_url": "https://github.com/devai-nyx/devai-original",
        "final_commit_sha": null,
        "final_tree_sha": null,
        "evidence_chain_head_sha256": null,
        "closing_decision": null,
        "closing_pc_record": null,
        "frozen": false
      },
      "imported_evidence": [],
      "non_claims": [
        "successor-standing-starts-at-zero"
      ]
    }
  ]
}
