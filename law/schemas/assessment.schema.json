{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/assessment.schema.json",
  "title": "Status Assessment",
  "description": "Human-readable Auditor status report derived from scorecard delta. Drives backlog refresh. Per Constitution Article 33 (Auditor as state estimator).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "generated_at",
    "scorecard_id",
    "previous_assessment_id",
    "narrative",
    "deltas",
    "backlog_actions",
    "recommended_priorities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^AS-[0-9]{8}T[0-9]{6}-[0-9]{3}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scorecard_id": {
      "type": "string",
      "pattern": "^SC-"
    },
    "previous_assessment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^AS-"
    },
    "narrative": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable summary, written by the Auditor agent."
    },
    "deltas": {
      "type": "array",
      "description": "Aspect-level changes since previous assessment.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "substrate",
          "property",
          "direction"
        ],
        "properties": {
          "substrate": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5"
            ]
          },
          "property": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "T5",
              "T6",
              "T7",
              "T8",
              "T9"
            ]
          },
          "direction": {
            "enum": [
              "improved",
              "regressed",
              "unchanged",
              "newly_evaluated"
            ]
          },
          "previous_verdict": {
            "enum": [
              "PASS",
              "REVIEW",
              "FAIL",
              "N/A",
              "UNKNOWN"
            ]
          },
          "current_verdict": {
            "enum": [
              "PASS",
              "REVIEW",
              "FAIL",
              "N/A",
              "UNKNOWN"
            ]
          },
          "delta_score": {
            "type": "number"
          }
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "substrate",
          "property",
          "summary"
        ],
        "properties": {
          "substrate": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5"
            ]
          },
          "property": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "T5",
              "T6",
              "T7",
              "T8",
              "T9"
            ]
          },
          "summary": {
            "type": "string"
          },
          "likely_cause_commits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "backlog_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additions",
        "completions",
        "deprioritizations"
      ],
      "properties": {
        "additions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "rationale"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^TASK-"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "completions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-"
          }
        },
        "deprioritizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^TASK-"
              },
              "new_priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "recommended_priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "priority",
          "rationale"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "quarantine_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_count": {
          "type": "integer",
          "minimum": 0
        },
        "added_since_last": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_since_last": {
          "type": "integer",
          "minimum": 0
        },
        "oldest_quarantined_age_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "open_rgrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RGR-"
      }
    },
    "open_escalations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ESC-"
      }
    }
  },
  "schema_version": "1.0.0"
}