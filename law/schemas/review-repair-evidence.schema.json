{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/review-repair-evidence.schema.json",
  "title": "Complete-class review repair evidence",
  "description": "Self-digested proof that every failed defect class and affected instance from one exact review result was repaired in a distinct candidate.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "prior_candidate_sha",
    "prior_candidate_manifest_digest",
    "prior_review_scope_digest",
    "prior_review_result_digest",
    "prior_failure_state_digest",
    "new_candidate_sha",
    "repaired_classes",
    "repair_evidence_digest_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "prior_candidate_sha": { "$ref": "#/$defs/sha1" },
    "prior_candidate_manifest_digest": { "$ref": "#/$defs/sha256" },
    "prior_review_scope_digest": { "$ref": "#/$defs/sha256" },
    "prior_review_result_digest": { "$ref": "#/$defs/sha256" },
    "prior_failure_state_digest": { "$ref": "#/$defs/sha256" },
    "new_candidate_sha": { "$ref": "#/$defs/sha1" },
    "repaired_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defect_class_id",
          "population_query",
          "affected_instances",
          "repaired_instances",
          "changed_paths",
          "verification_refs"
        ],
        "properties": {
          "defect_class_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$" },
          "population_query": { "type": "string", "minLength": 1 },
          "affected_instances": { "$ref": "#/$defs/strings" },
          "repaired_instances": { "$ref": "#/$defs/strings" },
          "changed_paths": { "$ref": "#/$defs/strings" },
          "verification_refs": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "repair_evidence_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "round": "R-9999",
      "prior_candidate_sha": "1111111111111111111111111111111111111111",
      "prior_candidate_manifest_digest": "2222222222222222222222222222222222222222222222222222222222222222",
      "prior_review_scope_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "prior_review_result_digest": "4444444444444444444444444444444444444444444444444444444444444444",
      "prior_failure_state_digest": "5555555555555555555555555555555555555555555555555555555555555555",
      "new_candidate_sha": "6666666666666666666666666666666666666666",
      "repaired_classes": [
        {
          "defect_class_id": "EXAMPLE_CLASS",
          "population_query": "Enumerate the complete example population.",
          "affected_instances": ["instance-a"],
          "repaired_instances": ["instance-a"],
          "changed_paths": ["scripts/example.mjs"],
          "verification_refs": ["tests/example.test.ts"]
        }
      ],
      "repair_evidence_digest_sha256": "7777777777777777777777777777777777777777777777777777777777777777"
    }
  ]
}
