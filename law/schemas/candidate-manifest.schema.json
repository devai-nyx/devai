{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/candidate-manifest.schema.json",
  "title": "Generic round-close candidate manifest",
  "description": "Exact base, candidate, tree, and evidence identities frozen before semantic review.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "base_sha",
    "candidate_sha",
    "tree_sha",
    "profile_digest",
    "policy_digest",
    "graph_digest",
    "candidate_identity_digest",
    "convergence_digest",
    "claims_digest",
    "reviewer_binding_digest",
    "declaration_id",
    "declaration_digest",
    "impact_execution_digest",
    "manifest_digest_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "base_sha": { "$ref": "#/$defs/sha1" },
    "candidate_sha": { "$ref": "#/$defs/sha1" },
    "tree_sha": { "$ref": "#/$defs/sha1" },
    "profile_digest": { "$ref": "#/$defs/sha256" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "graph_digest": { "$ref": "#/$defs/sha256" },
    "candidate_identity_digest": { "$ref": "#/$defs/sha256" },
    "convergence_digest": { "$ref": "#/$defs/sha256" },
    "claims_digest": { "$ref": "#/$defs/sha256" },
    "rehearsal_digest": { "$ref": "#/$defs/sha256" },
    "reviewer_binding_digest": { "$ref": "#/$defs/sha256" },
    "declaration_id": { "type": "string", "pattern": "^DII-[0-9]{3}$" },
    "declaration_digest": { "$ref": "#/$defs/sha256" },
    "impact_execution_digest": { "$ref": "#/$defs/sha256" },
    "previous_candidate_sha": {
      "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }]
    },
    "manifest_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "round": "R-9999",
      "base_sha": "0000000000000000000000000000000000000000",
      "candidate_sha": "1111111111111111111111111111111111111111",
      "tree_sha": "2222222222222222222222222222222222222222",
      "profile_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "policy_digest": "4444444444444444444444444444444444444444444444444444444444444444",
      "graph_digest": "5555555555555555555555555555555555555555555555555555555555555555",
      "candidate_identity_digest": "6666666666666666666666666666666666666666666666666666666666666666",
      "convergence_digest": "7777777777777777777777777777777777777777777777777777777777777777",
      "claims_digest": "8888888888888888888888888888888888888888888888888888888888888888",
      "reviewer_binding_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "declaration_id": "DII-999",
      "declaration_digest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "impact_execution_digest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "manifest_digest_sha256": "9999999999999999999999999999999999999999999999999999999999999999"
    }
  ]
}
