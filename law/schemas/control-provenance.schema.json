{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/control-provenance.schema.json",
  "title": "Exact-candidate active-control provenance graph",
  "description": "Structured roots and transitive edges used to derive the complete active-control census from raw exact-candidate blobs without implementation hardcoding or profile allowlist authority.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "root_decision",
    "decision_register",
    "decisions",
    "owner_mandates",
    "manifest_roots",
    "normative_source_roots",
    "derived_sources"
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "decisionId": {
      "type": "string",
      "pattern": "^DII-[0-9]+$"
    },
    "uniquePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "round": {
      "type": "string",
      "pattern": "^R-[0-9]{4}$"
    },
    "root_decision": {
      "$ref": "#/$defs/decisionId"
    },
    "decision_register": {
      "const": "law/register/DECISIONS.md"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "status", "depends_on"],
        "properties": {
          "decision_id": {
            "$ref": "#/$defs/decisionId"
          },
          "status": {
            "const": "active"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/decisionId"
            }
          }
        }
      }
    },
    "owner_mandates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mandate_id", "path", "required_status"],
        "properties": {
          "mandate_id": {
            "type": "string",
            "pattern": "^OM-[0-9]+$"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "required_status": {
            "const": "active"
          }
        }
      }
    },
    "manifest_roots": {
      "$ref": "#/$defs/uniquePaths"
    },
    "normative_source_roots": {
      "$ref": "#/$defs/uniquePaths"
    },
    "derived_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "policy-schema-map",
          "round-profile-sources",
          "round-declaration-when-bound",
          "prior-finding-origin-evidence",
          "obligation-source-references"
        ]
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "round": "R-0007",
      "root_decision": "DII-249",
      "decision_register": "law/register/DECISIONS.md",
      "decisions": [
        {
          "decision_id": "DII-246",
          "status": "active",
          "depends_on": []
        },
        {
          "decision_id": "DII-247",
          "status": "active",
          "depends_on": ["DII-246"]
        },
        {
          "decision_id": "DII-248",
          "status": "active",
          "depends_on": ["DII-246", "DII-247"]
        },
        {
          "decision_id": "DII-249",
          "status": "active",
          "depends_on": ["DII-246", "DII-247", "DII-248"]
        }
      ],
      "owner_mandates": [
        {
          "mandate_id": "OM-002",
          "path": "product/owner-mandates/OM-002.md",
          "required_status": "active"
        },
        {
          "mandate_id": "OM-003",
          "path": "product/owner-mandates/OM-003.md",
          "required_status": "active"
        },
        {
          "mandate_id": "OM-014",
          "path": "product/owner-mandates/OM-014.md",
          "required_status": "active"
        },
        {
          "mandate_id": "OM-015",
          "path": "product/owner-mandates/OM-015.md",
          "required_status": "active"
        },
        {
          "mandate_id": "OM-016",
          "path": "product/owner-mandates/OM-016.md",
          "required_status": "active"
        }
      ],
      "manifest_roots": [
        "AGENTS.md",
        "work/rounds/EXECUTION-CONTRACT.md",
        "work/rounds/R-0007/AUTHORIZATION.md",
        "work/rounds/R-0007/plan.md",
        "work/rounds/R-0007/prompts/00-orchestrator.md"
      ],
      "derived_sources": [
        "policy-schema-map",
        "round-profile-sources",
        "round-declaration-when-bound",
        "prior-finding-origin-evidence",
        "obligation-source-references"
      ],
      "normative_source_roots": [
        "AGENTS.md",
        "product/owner-mandates/OM-014.md",
        "product/owner-mandates/OM-015.md",
        "product/owner-mandates/OM-016.md",
        "work/rounds/EXECUTION-CONTRACT.md",
        "work/rounds/R-0007/AUTHORIZATION.md",
        "work/rounds/R-0007/plan.md",
        "work/rounds/R-0007/prompts/00-orchestrator.md"
      ]
    }
  ]
}
