{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/actions-list-output.schema.json",
  "title": "Actions List Output",
  "description": "The JSON output of `devai catalog actions`: the canonical 0.5 hierarchical command catalog.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "previous_name",
      "path",
      "description",
      "authority",
      "lifecycle",
      "lifecycle_reason",
      "promotion_criteria",
      "visibility",
      "tier",
      "profiles",
      "effects"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Canonical space-separated action path."
      },
      "previous_name": {
        "type": "string",
        "minLength": 1,
        "description": "The pre-0.5 action name used to generate the adopter migration inventory."
      },
      "path": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "description": "One-line description of what the action does."
      },
      "authority": {
        "description": "Authority owner of the action (Phase 11.G, absorbed from sibling-exploration's ActionAuthority taxonomy). Lets callers filter the catalog by who owns the verb.",
        "enum": [
          "mesh_controller",
          "specifier",
          "constructor",
          "sensor",
          "policy_firewall",
          "release_controller",
          "agent_runtime",
          "host_tooling"
        ]
      },
      "lifecycle": {
        "enum": ["supported", "experimental", "retired"]
      },
      "lifecycle_reason": {
        "type": "string",
        "minLength": 1
      },
      "promotion_criteria": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "visibility": {
        "enum": ["common", "standard", "advanced", "maintainer"]
      },
      "tier": {
        "enum": ["porcelain", "plumbing"],
        "description": "Declared command-surface tier. Porcelain actions appear in default help; plumbing actions require the expanded catalog."
      },
      "profiles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": ["tier1", "tier2", "tier3"]
        }
      },
      "effects": {
        "enum": ["read", "harness-write", "local-write", "remote-write"]
      },
      "authority_contract_version": {
        "const": "1.0.0",
        "description": "Staged linkage to authority-action-contract.schema.json. Optional for the pre-cutover W01 catalog so this presentation schema remains backward-valid; presence is not proof of enforcement. W02/W03 pin live mutation contracts and W06 makes their registry presence fail-closed. The existing `authority` field remains subsystem ownership, not a constitutional principal."
      }
    }
  },
  "schema_version": "1.0.0",
  "examples": [
    [
      {
        "name": "doctor",
        "previous_name": "doctor",
        "path": ["doctor"],
        "description": "Run repository health checks.",
        "authority": "sensor",
        "lifecycle": "supported",
        "lifecycle_reason": "Primary health-check surface.",
        "promotion_criteria": [],
        "visibility": "common",
        "tier": "porcelain",
        "profiles": ["tier1"],
        "effects": "read"
      }
    ]
  ]
}
