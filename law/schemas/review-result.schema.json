{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/review-result.schema.json",
  "title": "Structured exhaustive review result",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "cycle",
    "review_candidate",
    "manifest_digest",
    "policy_digest",
    "dispositions",
    "findings",
    "terminal"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "cycle": { "enum": [1, 2] },
    "review_candidate": { "$ref": "#/$defs/sha1" },
    "manifest_digest": { "$ref": "#/$defs/sha256" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "disposition",
          "recomputed_digest",
          "evidence_refs",
          "justification",
          "finding_ids"
        ],
        "properties": {
          "topic_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
          "disposition": {
            "enum": ["RECHECKED_PASS", "RECHECKED_FAIL", "REUSED_FRESH_PASS", "BLOCKED"]
          },
          "recomputed_digest": { "$ref": "#/$defs/sha256" },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "justification": { "type": "string", "minLength": 1 },
          "finding_ids": { "$ref": "#/$defs/stringList" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "defect_class_id",
          "severity",
          "topic_ids",
          "evidence",
          "population_query",
          "affected_instances",
          "repair_acceptance"
        ],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
          "defect_class_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "topic_ids": { "$ref": "#/$defs/stringList" },
          "evidence": { "type": "string", "minLength": 1 },
          "population_query": { "type": "string", "minLength": 1 },
          "affected_instances": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "repair_acceptance": { "type": "string", "minLength": 1 }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "topic_count", "disposition_counts", "finding_count", "complete"],
      "properties": {
        "verdict": { "enum": ["PASS", "FAIL", "BLOCKED", "INVALID"] },
        "topic_count": { "type": "integer", "minimum": 1 },
        "disposition_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["RECHECKED_PASS", "RECHECKED_FAIL", "REUSED_FRESH_PASS", "BLOCKED"],
          "properties": {
            "RECHECKED_PASS": { "type": "integer", "minimum": 0 },
            "RECHECKED_FAIL": { "type": "integer", "minimum": 0 },
            "REUSED_FRESH_PASS": { "type": "integer", "minimum": 0 },
            "BLOCKED": { "type": "integer", "minimum": 0 }
          }
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    }
  }
}
