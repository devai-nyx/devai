{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/documentation-information-architecture.schema.json",
  "title": "R-0007 documentation information architecture",
  "description": "Canonical routing, page-manifest, generated-reference boundary, semantic-field contract, completeness gates, and R-0009 claim ceiling for the R-0007 CLI documentation handoff.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "authority",
    "decision",
    "ordering",
    "claim_ceiling",
    "source_routing_rules",
    "semantic_fields",
    "pages",
    "categories",
    "completeness_gates",
    "r0007_handoff",
    "r0009_completion"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/documentation-information-architecture.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "r0007-documentation-information-architecture"
    },
    "status": {
      "const": "active"
    },
    "authority": {
      "const": "Architect"
    },
    "decision": {
      "const": "ADR-023"
    },
    "ordering": {
      "const": "policy-declared-page-category-and-projection-order"
    },
    "claim_ceiling": {
      "$ref": "#/$defs/claimCeiling"
    },
    "source_routing_rules": {
      "$ref": "#/$defs/sourceRoutingRules"
    },
    "semantic_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "completeness_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "r0007_handoff": {
      "$ref": "#/$defs/handoff"
    },
    "r0009_completion": {
      "$ref": "#/$defs/completion"
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?:docs|law|work/rounds/R-0007)/[A-Za-z0-9._/#*-]+$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pointer", "projection"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "pointer": {
          "type": "string",
          "pattern": "^#(?:/.*)?$"
        },
        "projection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claimCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_descriptor_handoff",
        "narrative_documentation_complete",
        "deploy_ready_site",
        "released",
        "deployed"
      ],
      "properties": {
        "canonical_descriptor_handoff": {
          "const": true
        },
        "narrative_documentation_complete": {
          "const": false
        },
        "deploy_ready_site": {
          "const": false
        },
        "released": {
          "const": false
        },
        "deployed": {
          "const": false
        }
      }
    },
    "sourceRoutingRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_sources_only",
        "narrative_population_copy",
        "generated_order",
        "generated_write_mode",
        "missing_source",
        "unknown_projection"
      ],
      "properties": {
        "canonical_sources_only": {
          "const": true
        },
        "narrative_population_copy": {
          "const": "forbidden"
        },
        "generated_order": {
          "const": "canonical-source-order"
        },
        "generated_write_mode": {
          "const": "check-without-write-or-deterministic-materialization"
        },
        "missing_source": {
          "const": "fail-closed"
        },
        "unknown_projection": {
          "const": "fail-closed"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "planned_path",
        "title",
        "purpose",
        "content_mode",
        "mutable_population_mode",
        "r0007_delivery",
        "r0009_completion",
        "category_ids",
        "source_refs"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "planned_path": {
          "type": "string",
          "pattern": "^docs/reference/cli/[a-z0-9-]+\\.md$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "content_mode": {
          "enum": ["narrative", "generated-reference", "narrative-with-generated-links"]
        },
        "mutable_population_mode": {
          "enum": ["none", "generated-from-canonical-source"]
        },
        "r0007_delivery": {
          "enum": ["canonical-descriptor", "minimum-operator-handoff"]
        },
        "r0009_completion": {
          "enum": ["conceptual-narrative", "generated-page-and-site-integration"]
        },
        "category_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_id",
        "page_id",
        "canonical_source",
        "source_refs",
        "population_contract",
        "ordering",
        "rendering"
      ],
      "properties": {
        "category_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "page_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "canonical_source": {
          "$ref": "#/$defs/repositoryPath"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "population_contract": {
          "const": "source-derived-exact-ordered-bijection-no-copied-list"
        },
        "ordering": {
          "enum": ["source-order", "utf8-bytes-after-deduplication"]
        },
        "rendering": {
          "const": "generated-reference"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "phase", "scope", "condition", "failure"],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^docs-[a-z0-9-]+$"
        },
        "phase": {
          "enum": ["b2-policy", "r0007-b5", "r0007-b6", "r0009"]
        },
        "scope": {
          "enum": [
            "policy",
            "page-manifest",
            "category",
            "entry",
            "example",
            "narrative",
            "claim"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "pattern": "^DOCS_[A-Z0-9_]+$"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "scope", "required_outputs", "completion_claim"],
      "properties": {
        "round": {
          "const": "R-0007"
        },
        "scope": {
          "const": "canonical-current-state-descriptors-and-operator-guidance"
        },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completion_claim": {
          "const": "handoff-complete-only"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "entry_dependency",
        "scope",
        "currently_exists",
        "currently_authorized"
      ],
      "properties": {
        "round": {
          "const": "R-0009"
        },
        "entry_dependency": {
          "const": "R-0008-closed-and-r0009-entry-check-passed"
        },
        "scope": {
          "const": "complete-narrative-user-documentation-generated-pages-site-integration-and-deploy-ready-artifact"
        },
        "currently_exists": {
          "const": false
        },
        "currently_authorized": {
          "const": false
        }
      }
    }
  },
  "examples": [
    {
      "$schema": "../schemas/documentation-information-architecture.schema.json",
      "schemaVersion": "1.0.0",
      "id": "r0007-documentation-information-architecture",
      "status": "active",
      "authority": "Architect",
      "decision": "ADR-023",
      "ordering": "policy-declared-page-category-and-projection-order",
      "claim_ceiling": {
        "canonical_descriptor_handoff": true,
        "narrative_documentation_complete": false,
        "deploy_ready_site": false,
        "released": false,
        "deployed": false
      },
      "source_routing_rules": {
        "canonical_sources_only": true,
        "narrative_population_copy": "forbidden",
        "generated_order": "canonical-source-order",
        "generated_write_mode": "check-without-write-or-deterministic-materialization",
        "missing_source": "fail-closed",
        "unknown_projection": "fail-closed"
      },
      "semantic_fields": ["stable_id"],
      "pages": [
        {
          "page_id": "cli-overview",
          "planned_path": "docs/reference/cli/index.md",
          "title": "CLI overview",
          "purpose": "Route readers into the workflow surface.",
          "content_mode": "narrative-with-generated-links",
          "mutable_population_mode": "none",
          "r0007_delivery": "minimum-operator-handoff",
          "r0009_completion": "conceptual-narrative",
          "category_ids": [],
          "source_refs": [
            {
              "path": "law/policy/action-registry.json",
              "pointer": "#/entries",
              "projection": "current workflow-domain mental model"
            }
          ]
        }
      ],
      "categories": [
        {
          "category_id": "check-suites",
          "page_id": "check-suites",
          "canonical_source": "law/policy/check-suites.json",
          "source_refs": [
            {
              "path": "law/policy/check-suites.json",
              "pointer": "#/suites",
              "projection": "entry identifiers in declared order"
            }
          ],
          "population_contract": "source-derived-exact-ordered-bijection-no-copied-list",
          "ordering": "source-order",
          "rendering": "generated-reference"
        }
      ],
      "completeness_gates": [
        {
          "gate_id": "docs-policy-schema",
          "phase": "b2-policy",
          "scope": "policy",
          "condition": "the policy validates against this schema",
          "failure": "DOCS_POLICY_SCHEMA_INVALID"
        }
      ],
      "r0007_handoff": {
        "round": "R-0007",
        "scope": "canonical-current-state-descriptors-and-operator-guidance",
        "required_outputs": ["machine-readable category report"],
        "completion_claim": "handoff-complete-only"
      },
      "r0009_completion": {
        "round": "R-0009",
        "entry_dependency": "R-0008-closed-and-r0009-entry-check-passed",
        "scope": "complete-narrative-user-documentation-generated-pages-site-integration-and-deploy-ready-artifact",
        "currently_exists": false,
        "currently_authorized": false
      }
    }
  ]
}
