{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/prior-finding-registry.schema.json",
  "title": "Prior review finding-class registry",
  "description": "Stable complete-class findings retained as mandatory topics for subsequent review cycles.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "round", "registry_version", "finding_classes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "registry_version": { "type": "string", "minLength": 1 },
    "finding_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "defect_class_id",
          "severity",
          "origin_cycle",
          "origin_evidence",
          "topic_ids",
          "population_query",
          "affected_population",
          "repair_condition",
          "disposition"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^(?:F|C[12]-F|R[0-9]+-F)[0-9]{3}$"
          },
          "defect_class_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]*$" },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "origin_cycle": { "enum": [1, 2] },
          "origin_evidence": { "type": "string", "minLength": 1 },
          "topic_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "population_query": { "type": "string", "minLength": 1 },
          "affected_population": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "repair_condition": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["OPEN", "REPAIRED_PENDING_REVIEW", "CLOSED"] }
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "round": "R-9999",
      "registry_version": "example-v1",
      "finding_classes": [
        {
          "finding_id": "F001",
          "defect_class_id": "EXAMPLE_CLASS",
          "severity": "P1",
          "origin_cycle": 1,
          "origin_evidence": "work/audit/R-9999/review-1.md",
          "topic_ids": ["example-topic"],
          "population_query": "Enumerate the complete example population.",
          "affected_population": ["example-instance"],
          "repair_condition": "Every enumerated instance satisfies the example invariant.",
          "disposition": "OPEN"
        }
      ]
    }
  ]
}
