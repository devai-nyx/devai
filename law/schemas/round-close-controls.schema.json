{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "law/schemas/round-close-controls.schema.json",
  "title": "Round close controls policy",
  "description": "The Architect-owned policy document that selects close-control behaviour. Per DII-253 the controller reads control vocabulary from this document rather than from literals in its own source, so the document is itself an authenticated input and must be validated on load alongside the round profile.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "policy_id",
    "policy_version",
    "control_capabilities",
    "schemas",
    "role_paths",
    "review_state_machine"
  ],
  "properties": {
    "schemaVersion": {
      "enum": ["4.0.0", "5.0.0"]
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": ["string", "null"]
    },
    "control_capabilities": {
      "type": "object",
      "minProperties": 1,
      "required": ["capability_version"],
      "properties": {
        "capability_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Per DII-252, generic capability selection. Every key other than capability_version is a boolean capability. A capability absent from this map is not enabled; the controller never infers one from a decision identifier."
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^law/schemas/[A-Za-z0-9._-]+\\.schema\\.json$"
      }
    },
    "role_paths": {
      "type": "object",
      "minProperties": 1
    },
    "review_state_machine": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "states",
        "initial_state",
        "allowed_transitions",
        "terminal_states",
        "cycle_two_states",
        "edge_cycle_derivation",
        "emitted_transition_sequences",
        "predecessor_persistence",
        "verdict_next_state",
        "canonical_history",
        "state_cycle_binding",
        "substantive_cycle_budget",
        "transport_retry_budget_per_cycle"
      ],
      "properties": {
        "states": {
          "$ref": "#/$defs/stateList"
        },
        "initial_state": {
          "$ref": "#/$defs/state"
        },
        "terminal_states": {
          "$ref": "#/$defs/stateList"
        },
        "cycle_two_states": {
          "$ref": "#/$defs/stateList",
          "description": "States whose presence at either endpoint of an edge derives cycle two. Replaces the controller-side literal sets that previously duplicated this rule at two sites free to drift."
        },
        "edge_cycle_derivation": {
          "type": "string",
          "minLength": 1
        },
        "allowed_transitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/state"
          },
          "additionalProperties": {
            "$ref": "#/$defs/stateList"
          }
        },
        "emitted_transition_sequences": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/state"
              }
            }
          },
          "description": "The exact edge sequence each cycle emits. Declared so the controller constructs bursts from law rather than from an inline literal list."
        },
        "predecessor_persistence": {
          "type": "string",
          "minLength": 1,
          "description": "Per DII-253 every emitted transition persists its target state before the next edge, so each non-initial transition binds a predecessor artifact that actually exists. No edge is exempt from predecessor-artifact corroboration."
        },
        "verdict_next_state": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        },
        "canonical_history": {
          "type": "object",
          "required": ["first_predecessor", "subsequent_predecessor"],
          "properties": {
            "first_predecessor": {
              "const": "null-only-for-DRAFT-origin"
            },
            "subsequent_predecessor": {
              "const": "exact-previous-state-and-transition-digests"
            }
          }
        },
        "state_cycle_binding": {
          "type": "object",
          "minProperties": 1
        },
        "substantive_cycle_budget": {
          "type": "integer",
          "minimum": 1
        },
        "transport_retry_budget_per_cycle": {
          "type": "integer",
          "minimum": 0
        },
        "forced_pass": {
          "const": false
        },
        "history_rewrite": {
          "const": "forbidden"
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "stateList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/state"
      }
    }
  }
}
