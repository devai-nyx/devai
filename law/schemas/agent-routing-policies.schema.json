{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/agent-routing-policies.schema.json",
  "title": "DEVAI agent-routing policy registry",
  "description": "Closed named and versioned agent-selection policies with ordered roster membership and fail-closed fallback semantics.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "authority",
    "decision",
    "registry",
    "identity",
    "resolution",
    "policies"
  ],
  "properties": {
    "$schema": { "const": "../schemas/agent-routing-policies.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "agent-routing-policies" },
    "status": { "const": "active" },
    "authority": { "const": "Architect" },
    "decision": { "const": "ADR-022" },
    "registry": { "const": "law/policy/model-runtime-registry.json" },
    "identity": { "$ref": "#/$defs/nonemptyObject" },
    "resolution": { "$ref": "#/$defs/nonemptyObject" },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "examples": [
    {
      "$schema": "../schemas/agent-routing-policies.schema.json",
      "schemaVersion": "1.0.0",
      "id": "agent-routing-policies",
      "status": "active",
      "authority": "Architect",
      "decision": "ADR-022",
      "registry": "law/policy/model-runtime-registry.json",
      "identity": { "implicit_latest": "forbidden" },
      "resolution": { "authority_source": "task.discipline" },
      "policies": [
        {
          "policy_id": "governed-coding",
          "policy_version": "1.0.0",
          "status": "active",
          "eligible_agent_classes": ["coding-agent"],
          "registry_ids": ["codex-cli:gpt-5.6-sol"],
          "allowed_efforts": ["high"],
          "fallback": "forbidden",
          "rationale": "Resolve only the exact rostered coding model for this named policy."
        }
      ]
    }
  ],
  "$defs": {
    "scalarOrArray": {
      "oneOf": [
        { "type": ["string", "boolean"] },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        { "$ref": "#/$defs/nonemptyObject" }
      ]
    },
    "nonemptyObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/scalarOrArray" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "status",
        "eligible_agent_classes",
        "registry_ids",
        "allowed_efforts",
        "fallback",
        "rationale"
      ],
      "properties": {
        "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "const": "active" },
        "eligible_agent_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "registry_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z0-9._-]+$" }
        },
        "allowed_efforts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["default", "low", "medium", "high", "xhigh", "max", "ultra"] }
        },
        "fallback": { "enum": ["only-next-listed-entry", "forbidden"] },
        "rationale": { "type": "string", "minLength": 20 }
      }
    }
  }
}
