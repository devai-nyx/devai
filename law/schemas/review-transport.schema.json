{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/review-transport.schema.json",
  "title": "Identity-bound review transport attempt",
  "description": "Self-digested transport validation attempt bound to one exact candidate, scope, reviewer, cycle, and predecessor attempt.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "cycle",
    "attempt",
    "candidate_sha",
    "candidate_manifest_digest",
    "review_scope_digest",
    "reviewer_binding_digest",
    "payload_digest",
    "validation",
    "state_before_digest",
    "previous_transport_digest",
    "transport_digest_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "cycle": { "enum": [1, 2] },
    "attempt": { "enum": [1, 2] },
    "candidate_sha": { "$ref": "#/$defs/sha1" },
    "candidate_manifest_digest": { "$ref": "#/$defs/sha256" },
    "review_scope_digest": { "$ref": "#/$defs/sha256" },
    "reviewer_binding_digest": { "$ref": "#/$defs/sha256" },
    "payload_digest": { "$ref": "#/$defs/sha256" },
    "validation": { "enum": ["VALID", "INVALID_TRANSPORT"] },
    "state_before_digest": { "$ref": "#/$defs/sha256" },
    "previous_transport_digest": { "$ref": "#/$defs/nullableSha256" },
    "transport_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "round": "R-9999",
      "cycle": 1,
      "attempt": 1,
      "candidate_sha": "1111111111111111111111111111111111111111",
      "candidate_manifest_digest": "2222222222222222222222222222222222222222222222222222222222222222",
      "review_scope_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "reviewer_binding_digest": "4444444444444444444444444444444444444444444444444444444444444444",
      "payload_digest": "5555555555555555555555555555555555555555555555555555555555555555",
      "validation": "INVALID_TRANSPORT",
      "state_before_digest": "6666666666666666666666666666666666666666666666666666666666666666",
      "previous_transport_digest": null,
      "transport_digest_sha256": "7777777777777777777777777777777777777777777777777777777777777777"
    }
  ]
}
