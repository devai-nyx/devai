{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/escalation.schema.json",
  "title": "Escalation",
  "description": "Convergence-failure escalation record. Distinct from RGR (reference-gap). Emitted when iteration cap is exhausted post-bump. Per Constitution Article 21.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "escalated_task_id",
    "created_at",
    "failure_class",
    "model_tiers_tried",
    "iteration_summary",
    "branch_preserved_as",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^ESC-[0-9]{4,}$"
    },
    "escalated_task_id": {
      "type": "string",
      "pattern": "^TASK-"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "failure_class": {
      "enum": [
        "hard_gate_failure",
        "soft_gate_failure",
        "iteration_cap_exhausted",
        "rebase_unresolvable",
        "test_weakening_unresolved",
        "tie_breaker_unresolved"
      ]
    },
    "model_tiers_tried": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "model", "iterations", "final_verdict"],
        "properties": {
          "tier": { "enum": ["default", "bumped", "fallback"] },
          "model": { "type": "string" },
          "iterations": { "type": "integer", "minimum": 1 },
          "final_verdict": { "enum": ["PASS", "REVIEW", "FAIL"] }
        }
      }
    },
    "iteration_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_iterations": { "type": "integer", "minimum": 1 },
        "hard_gate_failures_last": {
          "type": "array",
          "items": { "type": "string" }
        },
        "soft_gate_failures_last": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_chain_head": {
      "type": "string",
      "pattern": "^EV-",
      "description": "Last evidence record in the chain for this task; lets human pull full audit trail."
    },
    "branch_preserved_as": {
      "type": "string",
      "description": "Renamed branch (typically 'escalated/<task-id>')."
    },
    "worktree_destroyed_at": { "type": "string", "format": "date-time" },
    "locks_released": {
      "type": "array",
      "items": { "type": "string", "pattern": "^LOCK-" }
    },
    "status": {
      "enum": ["open", "human_adopted", "spec_revised", "cancelled", "resolved"]
    },
    "human_resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolved_at": { "type": "string", "format": "date-time" },
        "resolver": { "type": "string" },
        "path_taken": {
          "enum": ["adopt_branch_and_fix", "edit_spec_and_requeue", "cancel", "rollback_task"]
        },
        "notes": { "type": "string" }
      }
    }
  }
}
