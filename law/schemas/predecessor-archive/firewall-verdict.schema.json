{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/firewall-verdict.schema.json",
  "title": "Firewall Verdict",
  "description": "Unified verdict consolidating semantic, policy, prompt, and sensor-weakening classifications. Replaces the archive's three separate firewall schemas. Tri-state verdict per Constitution Article 18.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "generated_at",
    "verdict",
    "classifiers",
    "protected_surfaces",
    "required_actions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^FW-[a-f0-9]{16}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "description": "What is being firewalled (a task's diff, a policy change, a prompt overlay, etc.).",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "task_diff",
            "policy_change",
            "prompt_overlay",
            "config_change",
            "harness_upgrade"
          ]
        },
        "task_id": { "type": "string", "pattern": "^TASK-" },
        "ref": { "type": "string" }
      }
    },
    "verdict": {
      "enum": ["PASS", "REVIEW", "FAIL"]
    },
    "classifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_change", "policy_impact"],
      "properties": {
        "semantic_change": {
          "enum": ["none", "non_semantic", "semantic", "unknown"]
        },
        "policy_impact": {
          "enum": ["none", "potential", "explicit", "invalid"]
        },
        "prompt_impact": {
          "enum": ["none", "scope_change", "authority_expansion", "invalid"]
        },
        "sensor_weakening": {
          "enum": ["none", "within_threshold", "exceeds_threshold", "unjustified"]
        }
      }
    },
    "protected_surfaces": {
      "type": "array",
      "items": {
        "enum": [
          "auth",
          "rbac",
          "abac",
          "rls",
          "tenancy",
          "public_contract",
          "data_lifecycle",
          "security_controls",
          "release_controls",
          "audit"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error", "critical"] },
          "code": { "type": "string" },
          "file": { "type": "string" },
          "message": { "type": "string" },
          "invariant_id": { "type": "string", "pattern": "^INV-" }
        }
      }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "enum": [
          "rtd_reference_required",
          "human_signoff_required",
          "spec_update_required",
          "trace_update_required",
          "policy_revision_required",
          "rollback_required",
          "rgr_required",
          "none"
        ]
      }
    }
  }
}
