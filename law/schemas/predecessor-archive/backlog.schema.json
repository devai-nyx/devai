{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/backlog.schema.json",
  "title": "Backlog",
  "description": "Ordered queue of tasks. The only path by which work enters the framework (Constitution Article 35). Regenerated by the Auditor on every integration merge; mutated by orchestrator on task lifecycle events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generated_at", "integration_head", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "integration_head": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "priority", "status", "created_at"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "status": {
            "enum": [
              "queued",
              "ready",
              "lock_denied",
              "in_progress",
              "awaiting_human_review",
              "experimental_blocked",
              "completed",
              "escalated",
              "rgr_pending",
              "cancelled"
            ]
          },
          "created_at": { "type": "string", "format": "date-time" },
          "lifecycle": {
            "enum": ["supported", "experimental"],
            "default": "supported"
          },
          "blocked_by": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TASK-" },
            "description": "Tasks whose completion must precede this one (e.g., coupled-triplet upstream)."
          },
          "lock_denials": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of times this task was denied due to module lock contention. Bumps priority on each denial."
          },
          "source": {
            "enum": [
              "auditor:scorecard_delta",
              "auditor:rgr_resolution",
              "human:direct",
              "human:rollback",
              "harness:upgrade"
            ]
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queued": { "type": "integer", "minimum": 0 },
        "in_progress": { "type": "integer", "minimum": 0 },
        "escalated": { "type": "integer", "minimum": 0 },
        "rgr_pending": { "type": "integer", "minimum": 0 },
        "completed_since_last_regen": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
