{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/authority-action-contract.schema.json",
  "title": "Authority Action Contract",
  "description": "Fail-closed constitutional authority metadata for one registered action. This is distinct from the action catalog's subsystem-owner `authority` field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action_id",
    "effect",
    "subject",
    "consent",
    "planner",
    "boundary",
    "readiness"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*)*$"
    },
    "effect": {
      "enum": ["read", "harness-write", "local-write", "remote-write"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "enum": [
              "fs:f5-config",
              "fs:f5-state",
              "fs:f4-inventory",
              "fs:worktree-admin",
              "fs:workspace",
              "fs:unknown-write",
              "db:read",
              "db:write",
              "db:unclassified",
              "host-cache:write"
            ]
          },
          { "type": "string", "pattern": "^proc:[a-z][a-z0-9-]*$" },
          { "type": "string", "pattern": "^net:[a-z][a-z0-9-]*$" }
        ]
      },
      "description": "Declared per-domain effect upper bound. Optional only for the R24 W01 compatibility window; the live consistency gate introduced red-first in W02 and completed in W03 rejects a catalogued action without this field. fs:unknown-write and db:unclassified are shadow-only migration values that R25 must eliminate."
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "allowed_roles"],
          "properties": {
            "kind": { "const": "human" },
            "allowed_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actor", "transition", "initiator"],
          "properties": {
            "kind": { "const": "derived-machine" },
            "actor": {
              "enum": ["harness", "upgrade", "release"],
              "description": "bootstrap is intentionally absent: it may plan/orchestrate but has no mutation authority."
            },
            "transition": {
              "enum": ["harness-write", "upgrade", "release"]
            },
            "initiator": {
              "oneOf": [
                { "const": "none" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["allowed_roles", "preserve_in_context"],
                  "properties": {
                    "allowed_roles": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
                      },
                      "description": "The runtime binds exactly one actual initiated_by role from this set and requires it to match the invocation flag or session."
                    },
                    "preserve_in_context": { "const": true }
                  }
                }
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "actor": { "const": "harness" },
                "transition": { "const": "harness-write" }
              }
            },
            {
              "properties": {
                "actor": { "const": "upgrade" },
                "transition": { "const": "upgrade" },
                "initiator": {
                  "type": "object",
                  "required": ["allowed_roles"],
                  "properties": { "allowed_roles": { "const": ["architect"] } }
                }
              }
            },
            {
              "properties": {
                "actor": { "const": "release" },
                "transition": { "const": "release" },
                "initiator": {
                  "type": "object",
                  "required": ["allowed_roles"],
                  "properties": { "allowed_roles": { "const": ["architect"] } }
                }
              }
            }
          ]
        }
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write", "allow_publish", "experimental"],
      "properties": {
        "write": { "type": "boolean" },
        "allow_publish": { "type": "boolean" },
        "experimental": { "type": "boolean" }
      }
    },
    "planner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "planner_id", "target_kinds", "atomicity"],
          "properties": {
            "kind": { "const": "exact-plan" },
            "planner_id": { "type": "string", "minLength": 1 },
            "target_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["fs", "git-ref", "db", "remote"] }
            },
            "atomicity": { "const": "whole-plan" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "planner_id", "target_kinds", "bounds", "recovery"],
          "properties": {
            "kind": { "const": "bounded-batches" },
            "planner_id": { "type": "string", "minLength": 1 },
            "target_kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["fs", "git-ref", "db", "remote"] }
            },
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["max_batches", "max_targets_per_batch", "max_total_targets"],
              "properties": {
                "max_batches": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "max_targets_per_batch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "max_total_targets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              }
            },
            "recovery": { "const": "preserve-and-report" }
          }
        }
      ]
    },
    "boundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapter_ids", "final_reverification"],
          "properties": {
            "kind": { "const": "mutation-adapters" },
            "adapter_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "final_reverification": { "const": true }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_binding", "independent_acceptance_required"],
      "properties": {
        "requires_binding": { "type": "boolean" },
        "independent_acceptance_required": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "effect": { "const": "read" } }, "required": ["effect"] },
      "then": {
        "properties": {
          "subject": { "properties": { "kind": { "const": "none" } } },
          "consent": {
            "properties": {
              "write": { "const": false },
              "allow_publish": { "const": false }
            }
          },
          "planner": { "properties": { "kind": { "const": "none" } } },
          "boundary": { "properties": { "kind": { "const": "none" } } },
          "readiness": { "properties": { "requires_binding": { "const": false } } }
        }
      },
      "else": {
        "properties": {
          "subject": {
            "not": {
              "properties": { "kind": { "const": "none" } },
              "required": ["kind"]
            }
          },
          "consent": { "properties": { "write": { "const": true } } },
          "planner": {
            "not": {
              "properties": { "kind": { "const": "none" } },
              "required": ["kind"]
            }
          },
          "boundary": {
            "not": {
              "properties": { "kind": { "const": "none" } },
              "required": ["kind"]
            }
          },
          "readiness": { "properties": { "requires_binding": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "properties": { "effect": { "const": "remote-write" } },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "consent": { "properties": { "allow_publish": { "const": true } } }
        }
      }
    }
  ]
}
