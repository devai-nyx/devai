{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/module.schema.json",
  "title": "Module",
  "description": "F4 module unit. The granularity at which semantic locks are acquired (Constitution Article 25). Identified deterministically from repo structure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "substrate", "name", "path_globs", "kind"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^MOD-[A-Z][A-Z0-9]{1,15}-[a-z][a-z0-9_-]*$",
      "description": "MOD-<DOMAIN>-<slug>. Domain matches an entry in .devai/config/domains.json."
    },
    "substrate": {
      "enum": ["F1", "F2", "F3", "F4", "F5"],
      "description": "The primary substrate this module belongs to. F2 modules are the typical lock targets."
    },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "nestjs_module",
        "angular_module",
        "shared_lib",
        "db_schema",
        "migration_set",
        "iac_unit",
        "test_suite",
        "doc_bundle",
        "harness_module"
      ]
    },
    "path_globs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "File path globs defining the module's footprint."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^MOD-" },
      "description": "Other modules this module depends on (intra-repo). Computed from imports."
    },
    "invariants_owned": {
      "type": "array",
      "items": { "type": "string", "pattern": "^INV-" },
      "description": "Invariants whose scope.modules references this module."
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "description": "Public surface of the module.",
      "properties": {
        "routes": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } },
        "schemas": { "type": "array", "items": { "type": "string" } },
        "tables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loc": { "type": "integer", "minimum": 0 },
        "file_count": { "type": "integer", "minimum": 0 },
        "test_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
