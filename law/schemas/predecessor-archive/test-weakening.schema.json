{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/test-weakening.schema.json",
  "title": "Test Weakening Review",
  "description": "AST-diff review of test changes against parent commit. Tunable thresholds determine whether weakening is unjustified (FAIL) or acceptable refactor (PASS). REVIEW state requires human or stronger-model evaluation. Per Constitution Article 30 (amended).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "generated_at",
    "verdict",
    "changed_tests",
    "checked_files",
    "skipped_files",
    "violations",
    "thresholds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^TW-[a-f0-9]{16}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "parent_sha": {
      "type": "string",
      "description": "Git SHA of the commit being diffed against."
    },
    "head_sha": {
      "type": "string",
      "description": "Git SHA of the commit under review."
    },
    "verdict": {
      "enum": ["PASS", "REVIEW", "FAIL"]
    },
    "changed_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checked_files": { "type": "integer", "minimum": 0 },
    "skipped_files": { "type": "integer", "minimum": 0 },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "invariants", "reason", "before", "after", "delta", "diff_head"],
        "properties": {
          "file": { "type": "string" },
          "invariants": {
            "type": "array",
            "items": { "type": "string", "pattern": "^INV-" }
          },
          "reason": { "type": "string", "minLength": 1 },
          "before": { "$ref": "#/$defs/astMetrics" },
          "after": { "$ref": "#/$defs/astMetrics" },
          "delta": { "$ref": "#/$defs/astDelta" },
          "diff_head": {
            "type": "string",
            "maxLength": 4096,
            "description": "First N lines of the unified diff for human review."
          },
          "justified_by": {
            "type": "object",
            "additionalProperties": false,
            "description": "If present, weakening is justified by a tracked invariant change.",
            "properties": {
              "invariant_change_commit": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAssertionDecreaseRatio",
        "maxAssertionDecreaseAbs",
        "allowIfTestCasesIncrease"
      ],
      "properties": {
        "maxAssertionDecreaseRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Default 0.2: up to 20% assertion decrease is acceptable as refactor."
        },
        "maxAssertionDecreaseAbs": {
          "type": "integer",
          "minimum": 0,
          "description": "Default 1: absolute floor."
        },
        "allowIfTestCasesIncrease": {
          "type": "boolean",
          "description": "Default true: if test-case count grew, assertion decrease likely reflects split rather than weakening."
        }
      }
    }
  },
  "$defs": {
    "astMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testCases", "expectCalls", "assertionCalls"],
      "properties": {
        "testCases": { "type": "integer", "minimum": 0 },
        "expectCalls": { "type": "integer", "minimum": 0 },
        "assertionCalls": { "type": "integer", "minimum": 0 },
        "skipCalls": { "type": "integer", "minimum": 0 },
        "todoCalls": { "type": "integer", "minimum": 0 },
        "onlyCalls": { "type": "integer", "minimum": 0 },
        "httpStatusExpects": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "astDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testCases": { "type": "integer" },
        "expectCalls": { "type": "integer" },
        "assertionCalls": { "type": "integer" },
        "skipCalls": { "type": "integer" },
        "todoCalls": { "type": "integer" },
        "onlyCalls": { "type": "integer" },
        "httpStatusExpects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "removed": { "type": "array", "items": { "type": "integer" } },
            "added": { "type": "array", "items": { "type": "integer" } }
          }
        }
      }
    }
  }
}
