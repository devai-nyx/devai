{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.dev/schemas/authority-evidence.schema.json",
  "title": "Authority Evidence",
  "description": "Audit-only authority provenance for one governed invocation. It is not and cannot contain an issuer capability, nonce, bearer value, credential, or absolute host path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "record_kind",
    "id",
    "timestamp",
    "invocation_id",
    "repository_id",
    "action_id",
    "action_effect",
    "dry_run",
    "principal",
    "policy_binding",
    "enforcement_mode",
    "host_enforcement",
    "targets",
    "decision",
    "issuer_audit",
    "readiness"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "record_kind": { "const": "audit-only-non-capability" },
    "id": { "type": "string", "pattern": "^AUTH-EV-[a-f0-9]{16}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "invocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*)*$"
    },
    "action_effect": {
      "enum": ["read", "harness-write", "local-write", "remote-write"]
    },
    "dry_run": { "type": "boolean" },
    "principal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "role", "declaration_source"],
          "properties": {
            "kind": { "const": "human" },
            "role": {
              "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
            },
            "declaration_source": { "enum": ["cli-flag", "session-state"] },
            "session_id": {
              "type": "string",
              "pattern": "^AUTH-SESSION-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "declaration_source": { "const": "session-state" } },
                "required": ["declaration_source"]
              },
              "then": { "required": ["session_id"] },
              "else": { "not": { "required": ["session_id"] } }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "transition",
            "trusted_adapter_id",
            "context_digest_sha256",
            "initiated_by"
          ],
          "properties": {
            "kind": { "const": "derived-machine" },
            "actor": { "enum": ["harness", "bootstrap", "upgrade", "release"] },
            "transition": {
              "enum": ["harness-write", "bootstrap", "upgrade", "release"]
            },
            "trusted_adapter_id": { "type": "string", "minLength": 1 },
            "context_digest_sha256": { "$ref": "#/$defs/sha256" },
            "initiated_by": {
              "oneOf": [
                { "const": "none" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["role", "declaration_source"],
                  "properties": {
                    "role": {
                      "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
                    },
                    "declaration_source": { "enum": ["cli-flag", "session-state"] },
                    "session_id": {
                      "type": "string",
                      "pattern": "^AUTH-SESSION-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "declaration_source": { "const": "session-state" }
                        },
                        "required": ["declaration_source"]
                      },
                      "then": { "required": ["session_id"] },
                      "else": { "not": { "required": ["session_id"] } }
                    }
                  ]
                }
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "actor": { "const": "harness" },
                "transition": { "const": "harness-write" }
              }
            },
            {
              "properties": {
                "actor": { "const": "bootstrap" },
                "transition": { "const": "bootstrap" }
              }
            },
            {
              "properties": {
                "actor": { "const": "upgrade" },
                "transition": { "const": "upgrade" },
                "initiated_by": {
                  "type": "object",
                  "required": ["role"],
                  "properties": { "role": { "const": "architect" } }
                }
              }
            },
            {
              "properties": {
                "actor": { "const": "release" },
                "transition": { "const": "release" },
                "initiated_by": {
                  "type": "object",
                  "required": ["role"],
                  "properties": { "role": { "const": "architect" } }
                }
              }
            }
          ]
        }
      ]
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "package_version",
        "constitution_version",
        "constitution_digest_sha256",
        "source_digest_sha256",
        "resolved_digest_sha256",
        "extension_digests_sha256"
      ],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "$ref": "#/$defs/semver" },
        "package_version": { "$ref": "#/$defs/semver" },
        "constitution_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "constitution_digest_sha256": { "$ref": "#/$defs/sha256" },
        "source_digest_sha256": { "$ref": "#/$defs/sha256" },
        "resolved_digest_sha256": { "$ref": "#/$defs/sha256" },
        "extension_digests_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "enforcement_mode": { "enum": ["shadow", "binding"] },
    "host_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "attestation"],
      "properties": {
        "mode": { "enum": ["cli-only", "host-integrated"] },
        "adapter_id": { "type": "string", "minLength": 1 },
        "attestation": { "enum": ["not-applicable", "verified", "failed"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "host-integrated" } },
            "required": ["mode"]
          },
          "then": { "required": ["adapter_id"] },
          "else": {
            "properties": { "attestation": { "const": "not-applicable" } },
            "not": { "required": ["adapter_id"] }
          }
        }
      ]
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "kinds", "target_ids_digest_sha256", "summary"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["fs", "git-ref", "db", "remote"] }
        },
        "target_ids_digest_sha256": { "$ref": "#/$defs/sha256" },
        "summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "operation", "resource_id"],
            "properties": {
              "kind": { "enum": ["fs", "git-ref", "db", "remote"] },
              "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "resource_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@*/-]{1,240}$"
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_digest_sha256",
        "subject_digest_sha256",
        "evaluation",
        "disposition",
        "reason_code",
        "reasons"
      ],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "decision_digest_sha256": { "$ref": "#/$defs/sha256" },
        "subject_digest_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation": { "enum": ["allow", "deny", "not-applicable"] },
        "disposition": { "enum": ["proceed", "refuse"] },
        "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issuer_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_id",
        "issuer_version",
        "issued_at",
        "capability_material_present",
        "replayable"
      ],
      "properties": {
        "issuer_id": { "type": "string", "minLength": 1 },
        "issuer_version": { "$ref": "#/$defs/semver" },
        "issued_at": { "type": "string", "format": "date-time" },
        "capability_material_present": { "const": false },
        "replayable": { "const": false }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_eligible", "production_ready", "reason"],
      "properties": {
        "authority_eligible": { "type": "boolean" },
        "production_ready": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "principal": {
            "properties": { "actor": { "const": "bootstrap" } },
            "required": ["actor"]
          }
        },
        "required": ["principal"]
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": { "authority_eligible": { "const": false } }
          }
        },
        "oneOf": [
          {
            "properties": {
              "action_effect": { "const": "read" }
            }
          },
          {
            "properties": {
              "action_effect": {
                "enum": ["harness-write", "local-write", "remote-write"]
              },
              "decision": {
                "properties": {
                  "evaluation": { "const": "deny" },
                  "disposition": { "const": "refuse" }
                },
                "required": ["evaluation", "disposition"]
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "enforcement_mode": { "const": "shadow" } } },
          { "properties": { "dry_run": { "const": true } } },
          { "properties": { "action_effect": { "const": "read" } } },
          {
            "properties": {
              "decision": { "properties": { "disposition": { "const": "refuse" } } }
            }
          },
          {
            "properties": {
              "host_enforcement": {
                "properties": {
                  "mode": { "const": "host-integrated" },
                  "attestation": { "not": { "const": "verified" } }
                },
                "required": ["mode", "attestation"]
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "readiness": { "properties": { "authority_eligible": { "const": false } } }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    }
  }
}
