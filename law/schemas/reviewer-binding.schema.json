{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/reviewer-binding.schema.json",
  "title": "Owner reviewer binding marker",
  "description": "Structured Owner-only marker that binds one round to one independent reviewer model with no fallback.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "devai_reviewer_binding",
    "mandate_id",
    "mandate_status",
    "round",
    "model_selector",
    "role",
    "semantic_census",
    "substantive_cycles",
    "transport_retries",
    "fallback"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "devai_reviewer_binding": { "const": true },
    "mandate_id": { "type": "string", "pattern": "^OM-[0-9]{3}$" },
    "mandate_status": { "const": "active" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "model_selector": { "type": "string", "minLength": 1 },
    "role": { "const": "independent-read-only" },
    "semantic_census": { "const": "complete" },
    "substantive_cycles": { "const": 2 },
    "transport_retries": { "const": 1 },
    "fallback": { "const": "forbidden" }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "devai_reviewer_binding": true,
      "mandate_id": "OM-999",
      "mandate_status": "active",
      "round": "R-9999",
      "model_selector": "reviewer-model-exact",
      "role": "independent-read-only",
      "semantic_census": "complete",
      "substantive_cycles": 2,
      "transport_retries": 1,
      "fallback": "forbidden"
    }
  ]
}
