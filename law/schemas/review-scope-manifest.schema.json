{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/review-scope-manifest.schema.json",
  "title": "Generic exhaustive review-scope manifest",
  "description": "Machine-generated exact-candidate semantic review census. Every changed and unchanged topic is mandatory.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy_version",
    "round",
    "cycle",
    "exact_base",
    "review_candidate",
    "candidate_tree",
    "policy_digest",
    "profile_digest",
    "graph_digest",
    "obligations_digest",
    "claims_digest",
    "active_controls_digest",
    "prior_findings_digest",
    "impact_plan_digest",
    "convergence_evidence_digest",
    "current_candidate_manifest_digest",
    "previous_candidate_manifest_digests",
    "topic_count",
    "topics",
    "manifest_digest_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "freshnessProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "inputs_digest",
        "evidence_digest",
        "independent_recomputation_required"
      ],
      "properties": {
        "method": { "enum": ["content-addressed", "recheck-required"] },
        "inputs_digest": { "$ref": "#/$defs/sha256" },
        "evidence_digest": { "$ref": "#/$defs/sha256" },
        "task_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "independent_recomputation_required": { "const": true }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "policy_version": { "type": "string", "minLength": 1 },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "cycle": { "enum": [1, 2] },
    "exact_base": { "$ref": "#/$defs/sha1" },
    "review_candidate": { "$ref": "#/$defs/sha1" },
    "candidate_tree": { "$ref": "#/$defs/sha1" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "profile_digest": { "$ref": "#/$defs/sha256" },
    "graph_digest": { "$ref": "#/$defs/sha256" },
    "obligations_digest": { "$ref": "#/$defs/sha256" },
    "claims_digest": { "$ref": "#/$defs/sha256" },
    "active_controls_digest": { "$ref": "#/$defs/sha256" },
    "prior_findings_digest": { "$ref": "#/$defs/sha256" },
    "impact_plan_digest": { "$ref": "#/$defs/sha256" },
    "convergence_evidence_digest": { "$ref": "#/$defs/sha256" },
    "current_candidate_manifest_digest": { "$ref": "#/$defs/sha256" },
    "previous_candidate_manifest_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "topic_count": { "type": "integer", "minimum": 1 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "topic_kind",
          "obligation_id",
          "risk",
          "claim",
          "source_refs",
          "governing_paths",
          "required_evidence",
          "current_digest",
          "previous_digest",
          "changed_status",
          "required_adversaries",
          "previous_finding_classes",
          "freshness_proof",
          "allowed_dispositions"
        ],
        "properties": {
          "topic_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
          "topic_kind": {
            "enum": [
              "semantic-obligation",
              "changed-path",
              "active-control",
              "current-claim",
              "previous-finding-class",
              "candidate-identity",
              "convergence-evidence"
            ]
          },
          "obligation_id": { "type": "string", "pattern": "^R[0-9]+-[A-Z0-9][A-Z0-9-]*$" },
          "risk": { "enum": ["P0", "P1", "P2"] },
          "claim": { "type": "string", "minLength": 1 },
          "source_refs": { "$ref": "#/$defs/nonEmptyStrings" },
          "governing_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativePath" }
          },
          "required_evidence": { "$ref": "#/$defs/nonEmptyStrings" },
          "current_digest": { "$ref": "#/$defs/sha256" },
          "previous_digest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "changed_status": { "enum": ["added", "changed", "unchanged", "removed"] },
          "required_adversaries": { "$ref": "#/$defs/nonEmptyStrings" },
          "previous_finding_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "freshness_proof": { "$ref": "#/$defs/freshnessProof" },
          "allowed_dispositions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["RECHECKED_PASS", "RECHECKED_FAIL", "REUSED_FRESH_PASS", "BLOCKED"]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "changed_status": { "enum": ["added", "changed", "removed"] } }
            },
            "then": {
              "properties": {
                "allowed_dispositions": {
                  "not": { "contains": { "const": "REUSED_FRESH_PASS" } }
                }
              }
            }
          }
        ]
      }
    },
    "manifest_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "policy_version": "2.0.0",
      "round": "R-9999",
      "cycle": 1,
      "exact_base": "0000000000000000000000000000000000000000",
      "review_candidate": "1111111111111111111111111111111111111111",
      "candidate_tree": "2222222222222222222222222222222222222222",
      "policy_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "profile_digest": "4444444444444444444444444444444444444444444444444444444444444444",
      "graph_digest": "5555555555555555555555555555555555555555555555555555555555555555",
      "obligations_digest": "6666666666666666666666666666666666666666666666666666666666666666",
      "claims_digest": "7777777777777777777777777777777777777777777777777777777777777777",
      "active_controls_digest": "1212121212121212121212121212121212121212121212121212121212121212",
      "prior_findings_digest": "1313131313131313131313131313131313131313131313131313131313131313",
      "impact_plan_digest": "1414141414141414141414141414141414141414141414141414141414141414",
      "convergence_evidence_digest": "1515151515151515151515151515151515151515151515151515151515151515",
      "current_candidate_manifest_digest": "8888888888888888888888888888888888888888888888888888888888888888",
      "previous_candidate_manifest_digests": [],
      "topic_count": 1,
      "topics": [
        {
          "topic_id": "obligation:r9999-p0-identity",
          "topic_kind": "semantic-obligation",
          "obligation_id": "R9999-P0-IDENTITY",
          "risk": "P0",
          "claim": "The review binds the exact candidate.",
          "source_refs": ["work/rounds/R-9999/plan.md#acceptance"],
          "governing_paths": ["work/rounds/R-9999/plan.md"],
          "required_evidence": ["candidate manifest"],
          "current_digest": "9999999999999999999999999999999999999999999999999999999999999999",
          "previous_digest": null,
          "changed_status": "added",
          "required_adversaries": ["wrong-sha"],
          "previous_finding_classes": [],
          "freshness_proof": {
            "method": "recheck-required",
            "inputs_digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "evidence_digest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "task_keys": [],
            "independent_recomputation_required": true
          },
          "allowed_dispositions": ["RECHECKED_PASS", "RECHECKED_FAIL", "BLOCKED"]
        }
      ],
      "manifest_digest_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    }
  ]
}
