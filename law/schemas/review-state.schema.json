{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/review-state.schema.json",
  "title": "Authenticated bounded review state chain",
  "description": "Self-digested exact-candidate state and complete predecessor-linked transition history for bounded substantive review.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "state",
    "cycle",
    "base_sha",
    "candidate_sha",
    "tree_sha",
    "profile_digest",
    "policy_digest",
    "candidate_manifest_digest",
    "review_scope_digest",
    "reviewer_binding_digest",
    "transition_history",
    "transport_attempts",
    "state_digest_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha1": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
    "nullableSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "stateName": {
      "enum": [
        "DRAFT",
        "PREFLIGHT_GREEN",
        "CANDIDATE_FROZEN",
        "CYCLE_1_ACTIVE",
        "REPAIR_REQUIRED",
        "NEW_CANDIDATE_FROZEN",
        "CYCLE_2_ACTIVE",
        "PASS",
        "ESCALATION_REQUIRED",
        "REVIEW_TRANSPORT_BLOCKED"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "candidate_sha",
        "candidate_manifest_digest",
        "review_scope_digest",
        "review_result_digest",
        "transport_digest",
        "repair_evidence_digest",
        "previous_state_digest",
        "transition_digest_sha256"
      ],
      "properties": {
        "from": { "$ref": "#/$defs/stateName" },
        "to": { "$ref": "#/$defs/stateName" },
        "candidate_sha": { "$ref": "#/$defs/sha1" },
        "candidate_manifest_digest": { "$ref": "#/$defs/nullableSha256" },
        "review_scope_digest": { "$ref": "#/$defs/nullableSha256" },
        "review_result_digest": { "$ref": "#/$defs/nullableSha256" },
        "transport_digest": { "$ref": "#/$defs/nullableSha256" },
        "repair_evidence_digest": { "$ref": "#/$defs/nullableSha256" },
        "previous_state_digest": { "$ref": "#/$defs/nullableSha256" },
        "transition_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "state": { "$ref": "#/$defs/stateName" },
    "cycle": { "enum": [1, 2] },
    "base_sha": { "$ref": "#/$defs/sha1" },
    "candidate_sha": { "$ref": "#/$defs/sha1" },
    "tree_sha": { "$ref": "#/$defs/sha1" },
    "profile_digest": { "$ref": "#/$defs/sha256" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "candidate_manifest_digest": { "$ref": "#/$defs/sha256" },
    "review_scope_digest": { "$ref": "#/$defs/sha256" },
    "reviewer_binding_digest": { "$ref": "#/$defs/sha256" },
    "previous_candidate_sha": { "$ref": "#/$defs/nullableSha1" },
    "prior_failure_result_digest": { "$ref": "#/$defs/nullableSha256" },
    "repair_evidence_digest": { "$ref": "#/$defs/nullableSha256" },
    "transition_history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    },
    "transport_attempts": { "type": "integer", "minimum": 0, "maximum": 2 },
    "state_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "round": "R-9999",
      "state": "CYCLE_1_ACTIVE",
      "cycle": 1,
      "base_sha": "0000000000000000000000000000000000000000",
      "candidate_sha": "1111111111111111111111111111111111111111",
      "tree_sha": "2222222222222222222222222222222222222222",
      "profile_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "policy_digest": "4444444444444444444444444444444444444444444444444444444444444444",
      "candidate_manifest_digest": "5555555555555555555555555555555555555555555555555555555555555555",
      "review_scope_digest": "6666666666666666666666666666666666666666666666666666666666666666",
      "reviewer_binding_digest": "7777777777777777777777777777777777777777777777777777777777777777",
      "transition_history": [
        {
          "from": "CANDIDATE_FROZEN",
          "to": "CYCLE_1_ACTIVE",
          "candidate_sha": "1111111111111111111111111111111111111111",
          "candidate_manifest_digest": "5555555555555555555555555555555555555555555555555555555555555555",
          "review_scope_digest": "6666666666666666666666666666666666666666666666666666666666666666",
          "review_result_digest": null,
          "transport_digest": null,
          "repair_evidence_digest": null,
          "previous_state_digest": null,
          "transition_digest_sha256": "8888888888888888888888888888888888888888888888888888888888888888"
        }
      ],
      "transport_attempts": 0,
      "state_digest_sha256": "9999999999999999999999999999999999999999999999999999999999999999"
    }
  ]
}
