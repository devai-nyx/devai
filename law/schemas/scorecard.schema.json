{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/scorecard.schema.json",
  "title": "Scorecard",
  "description": "F \u00d7 T aspect grid scoring of the repository state. Computed by the Auditor on every integration merge and on demand. Cells marked N/A for degenerate aspects (Constitution Article 5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "generated_at",
    "integration_head",
    "thresholds_used",
    "cells",
    "substrate_aggregates",
    "invariant_rollups",
    "overall"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^SC-[0-9]{8}T[0-9]{6}-[0-9]{3}$",
      "description": "SC-YYYYMMDDThhmmss-NNN. Date-stamped with sub-second counter."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "integration_head": {
      "type": "string"
    },
    "previous_scorecard_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SC-"
    },
    "cycle": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Multi-cycle gate marker (Phase 16.D, D-50). A = local-dev checkpoint (L0 static only). B = branch-handoff / PR draft (L0 + L1 dynamic). C = merge / release / production deploy (all configured tiers including semantic). When the scorecard is computed via `devai govern score compute --cycle <A|B|C>`, the aggregator filters readings to those whose `tier` is appropriate for that cycle. Absent = aggregate across all tiers (current default, equivalent to Cycle C semantics)."
    },
    "thresholds_used": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "substrate",
          "property",
          "verdict",
          "deterministic"
        ],
        "properties": {
          "substrate": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5"
            ]
          },
          "property": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "T5",
              "T6",
              "T7",
              "T8",
              "T9"
            ]
          },
          "verdict": {
            "enum": [
              "PASS",
              "REVIEW",
              "FAIL",
              "N/A",
              "UNKNOWN"
            ]
          },
          "deterministic": {
            "type": "boolean"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "Normalized 0-1 score where applicable. Null for binary or N/A cells."
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "interval_low": {
                "type": "number"
              },
              "interval_high": {
                "type": "number"
              }
            }
          },
          "sensor_readings": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SR-"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV-"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "substrate_aggregates": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^F[1-5]$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "PASS",
                "REVIEW",
                "FAIL",
                "UNKNOWN"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "invariant_rollups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invariant_id",
          "verdict"
        ],
        "properties": {
          "invariant_id": {
            "type": "string",
            "pattern": "^INV-"
          },
          "verdict": {
            "enum": [
              "PASS",
              "REVIEW",
              "FAIL",
              "UNCOVERED"
            ]
          },
          "test_pass_count": {
            "type": "integer",
            "minimum": 0
          },
          "test_fail_count": {
            "type": "integer",
            "minimum": 0
          },
          "trace_resolved": {
            "type": "boolean"
          }
        }
      }
    },
    "quarantine_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of tests currently in quarantine (Article 31). Scored as Observation \u00d7 Discipline."
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "REVIEW",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "narrative": {
          "type": "string"
        }
      }
    }
  },
  "schema_version": "1.0.0"
}