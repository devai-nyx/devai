{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/affected-test-graph.schema.json",
  "title": "Explicit affected-test dependency graph",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graph_version",
    "round",
    "population",
    "shared_inputs",
    "nodes",
    "fallbacks",
    "coverage"
  ],
  "$defs": {
    "selector": { "type": "string", "minLength": 1 },
    "selectorList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/selector" }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "graph_version": { "type": "string", "minLength": 1 },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "tests", "classification"],
      "properties": {
        "production": { "$ref": "#/$defs/selectorList" },
        "tests": { "$ref": "#/$defs/selectorList" },
        "classification": { "const": "complete-or-full-suite-fallback" },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "reason"],
            "properties": {
              "selector": { "$ref": "#/$defs/selector" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "shared_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selectors", "invalidates"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "selectors": { "$ref": "#/$defs/selectorList" },
          "invalidates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "input_selectors", "depends_on", "command", "cwd", "outputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "kind": { "enum": ["test-shard", "gate", "fallback"] },
          "input_selectors": { "$ref": "#/$defs/selectorList" },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "command": { "$ref": "#/$defs/argv" },
          "cwd": { "type": "string", "minLength": 1 },
          "outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/selector" }
          },
          "coverage_mode": { "enum": ["none", "whole-only"] }
        }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_dependency", "dynamic_import", "incomplete_population"],
      "properties": {
        "unknown_dependency": { "type": "string", "minLength": 1 },
        "dynamic_import": { "type": "string", "minLength": 1 },
        "incomplete_population": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "mode", "partial_merge"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "mode": { "const": "whole-only" },
        "partial_merge": { "const": "forbidden" }
      }
    }
  }
}
