{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/affected-test-graph.schema.json",
  "title": "Explicit affected-test dependency graph",
  "description": "Versioned source, test, shared-input, gate, fallback, and whole-coverage dependency graph for conservative local impact planning.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graph_version",
    "round",
    "population",
    "shared_inputs",
    "nodes",
    "change_detection",
    "gate_freshness_profiles",
    "command_closure",
    "fallbacks",
    "coverage"
  ],
  "$defs": {
    "selector": {
      "type": "string",
      "minLength": 1
    },
    "selectorList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selector"
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selector"
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "graph_version": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "string",
      "pattern": "^R-[0-9]{4}$"
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_tracked", "production", "tests", "classification"],
      "properties": {
        "all_tracked": {
          "type": "array",
          "prefixItems": [
            {
              "const": "**/*"
            }
          ],
          "items": false
        },
        "production": {
          "$ref": "#/$defs/selectorList"
        },
        "tests": {
          "$ref": "#/$defs/selectorList"
        },
        "classification": {
          "const": "complete-or-full-suite-fallback"
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "reason"],
            "properties": {
              "selector": {
                "$ref": "#/$defs/selector"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "shared_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selectors", "invalidates"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "selectors": {
            "$ref": "#/$defs/selectorList"
          },
          "invalidates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "input_selectors", "depends_on", "command", "cwd", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "enum": ["test-shard", "gate", "fallback"]
          },
          "input_selectors": {
            "$ref": "#/$defs/selectorList"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "command": {
            "$ref": "#/$defs/argv"
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/selector"
            }
          },
          "coverage_mode": {
            "enum": ["none", "whole-only"]
          }
        }
      }
    },
    "change_detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed_command",
        "record_format",
        "rename_paths",
        "selector_population",
        "review_topics"
      ],
      "properties": {
        "committed_command": {
          "const": "git diff --name-status -z -M --find-renames <exact-base> <candidate>"
        },
        "record_format": {
          "const": "status-aware-nul"
        },
        "rename_paths": {
          "const": "retain-preimage-and-postimage"
        },
        "selector_population": {
          "const": "union-of-preimage-and-postimage"
        },
        "review_topics": {
          "const": "exactly-once-per-path-linked-by-change-record"
        }
      }
    },
    "freshness_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "tree_entries", "history_sensitive_gates", "outputs"],
      "properties": {
        "candidate": {
          "const": "literal-commit-and-tree"
        },
        "tree_entries": {
          "const": "path-mode-type-object-and-raw-blob"
        },
        "history_sensitive_gates": {
          "const": "bind-commit-history-and-range"
        },
        "outputs": {
          "const": "declared-complete-including-ignored"
        }
      }
    },
    "gate_freshness_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "input_selectors",
          "dependency_selectors",
          "toolchain_probe_ids",
          "environment_input_ids",
          "output_contract",
          "required_outputs",
          "universal_input_proof",
          "output_observation"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "input_selectors": {
            "$ref": "#/$defs/selectorList"
          },
          "dependency_selectors": {
            "$ref": "#/$defs/pathList"
          },
          "toolchain_probe_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "environment_input_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "oneOf": [
                {
                  "const": "__ALL_ENVIRONMENT__"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              ]
            }
          },
          "output_contract": {
            "enum": ["none", "digest-required"]
          },
          "required_outputs": {
            "$ref": "#/$defs/pathList"
          },
          "universal_input_proof": {
            "const": "tracked-candidate-tree"
          },
          "output_observation": {
            "const": "declared-plus-observed"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "output_contract": {
                  "const": "none"
                }
              }
            },
            "then": {
              "properties": {
                "required_outputs": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "output_contract": {
                  "const": "digest-required"
                }
              }
            },
            "then": {
              "properties": {
                "required_outputs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "command_closure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "scripts", "programs"],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "derivation": {
            "const": "recursive-policy-command-v1"
          },
          "closure_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scripts": {
            "$ref": "#/$defs/selectorList"
          },
          "programs": {
            "$ref": "#/$defs/selectorList"
          },
          "executables": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Executables reached by the derivation, including missing:<path> for a candidate executable that cannot be read."
          },
          "project_references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "TypeScript projects, extends chains, declared outputs and roots reached transitively."
          }
        }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_dependency", "dynamic_import", "incomplete_population"],
      "properties": {
        "unknown_dependency": {
          "type": "string",
          "minLength": 1
        },
        "dynamic_import": {
          "type": "string",
          "minLength": 1
        },
        "incomplete_population": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "mode", "partial_merge"],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "whole-only"
        },
        "partial_merge": {
          "const": "forbidden"
        }
      }
    },
    "authoritative_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "execution", "equivalent_node", "boundary", "freshness_profile"],
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "execution": {
            "const": "policy-command-exactly-once-per-cold-pass"
          },
          "equivalent_node": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "boundary": {
            "const": "exact-head-clean-no-write-equivalent"
          },
          "freshness_profile": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "graph_version": "example-v1",
      "round": "R-9999",
      "population": {
        "production": ["packages/*/src/**/*.ts"],
        "tests": ["tests/**/*.test.ts"],
        "classification": "complete-or-full-suite-fallback"
      },
      "shared_inputs": [
        {
          "id": "workspace",
          "selectors": ["package.json"],
          "invalidates": ["full-suite"]
        }
      ],
      "nodes": [
        {
          "id": "full-suite",
          "kind": "fallback",
          "input_selectors": ["packages/**/*.ts", "tests/**/*.ts"],
          "depends_on": [],
          "command": ["pnpm", "vitest", "run"],
          "cwd": ".",
          "outputs": [],
          "coverage_mode": "none"
        }
      ],
      "change_detection": {
        "committed_command": "git diff --name-status -z -M --find-renames <exact-base> <candidate>",
        "record_format": "status-aware-nul",
        "rename_paths": "retain-preimage-and-postimage",
        "selector_population": "union-of-preimage-and-postimage",
        "review_topics": "exactly-once-per-path-linked-by-change-record"
      },
      "freshness_identity": {
        "candidate": "literal-commit-and-tree",
        "tree_entries": "path-mode-type-object-and-raw-blob",
        "history_sensitive_gates": "bind-commit-history-and-range",
        "outputs": "declared-complete-including-ignored"
      },
      "gate_freshness_profiles": [
        {
          "gate_id": "ordinary",
          "input_selectors": ["packages/**/*.ts", "tests/**/*.ts"],
          "dependency_selectors": ["package.json", "pnpm-lock.yaml"],
          "toolchain_probe_ids": ["node", "pnpm", "vitest"],
          "environment_input_ids": ["CI", "NODE_ENV"],
          "output_contract": "none",
          "required_outputs": []
        }
      ],
      "fallbacks": {
        "unknown_dependency": "full-suite",
        "dynamic_import": "full-suite",
        "incomplete_population": "full-suite"
      },
      "coverage": {
        "node": "full-suite",
        "mode": "whole-only",
        "partial_merge": "forbidden"
      },
      "authoritative_gates": [
        {
          "gate_id": "ordinary",
          "execution": "policy-command-exactly-once-per-cold-pass",
          "equivalent_node": "full-suite",
          "boundary": "exact-head-clean-no-write-equivalent",
          "freshness_profile": "ordinary"
        }
      ],
      "command_closure": [
        {
          "gate_id": "ordinary",
          "derivation": "recursive-policy-command-v1",
          "scripts": ["direct:vitest-run"],
          "programs": ["pnpm", "vitest"]
        }
      ]
    }
  ]
}
