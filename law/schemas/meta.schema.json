{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/meta.schema.json",
  "title": "DEVAI-II schema meta-schema (thin declarative gate)",
  "description": "Every schema in law/schemas/ (predecessor-archive excluded) validates against this in the T2 contract tier. Recursive canon rules (closed-world every node, no restated common vocabulary, enum generation markers, dereferenced-publish byte-match) live in `check schemas`, not here \u2014 deliberately not a custom dialect.",
  "schema_version": "1.0.0",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "pattern": "^https://devai\\.nyxk\\.com\\.br/schemas/[a-z0-9-]+\\.schema\\.json$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "examples": {
      "type": "array",
      "minItems": 1
    }
  },
  "required": ["$schema", "$id", "title", "description", "schema_version", "examples"],
  "examples": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://devai.nyxk.com.br/schemas/example.schema.json",
      "title": "Example schema",
      "description": "Minimal meta-schema-conforming schema.",
      "schema_version": "1.0.0",
      "examples": [{}]
    }
  ]
}
