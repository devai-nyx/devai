{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/round-close-profile.schema.json",
  "title": "Per-round close-control profile",
  "description": "Per-round sources, runtime paths, reviewer binding, review budget, remote-CI behavior, and deployment boundary for the generic controller.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "policy_version",
    "decision_id",
    "phase",
    "sources",
    "runtime",
    "reviewer",
    "review_budget",
    "remote_ci"
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    }
  },
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "policy_version": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "pattern": "^DII-[0-9]{3}$" },
    "phase": { "enum": ["pre-entry-preparation", "entry", "execution", "close"] },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "plan",
        "orchestrator",
        "affected_test_graph",
        "obligations",
        "current_claims"
      ],
      "properties": {
        "authorization": { "$ref": "#/$defs/relativePath" },
        "plan": { "$ref": "#/$defs/relativePath" },
        "orchestrator": { "$ref": "#/$defs/relativePath" },
        "affected_test_graph": { "$ref": "#/$defs/relativePath" },
        "obligations": { "$ref": "#/$defs/relativePath" },
        "current_claims": { "$ref": "#/$defs/relativePath" },
        "additional_controls": { "$ref": "#/$defs/pathList" },
        "prior_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "prior_finding_registry": { "$ref": "#/$defs/relativePath" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_root",
        "candidate_manifest",
        "convergence_evidence",
        "review_scope",
        "review_result",
        "materialized_claims",
        "review_state",
        "review_transport",
        "review_repair_evidence"
      ],
      "properties": {
        "state_root": { "$ref": "#/$defs/relativePath" },
        "candidate_manifest": { "$ref": "#/$defs/relativePath" },
        "convergence_evidence": { "$ref": "#/$defs/relativePath" },
        "review_scope": { "$ref": "#/$defs/relativePath" },
        "review_result": { "$ref": "#/$defs/relativePath" },
        "materialized_claims": { "$ref": "#/$defs/relativePath" },
        "review_state": { "$ref": "#/$defs/relativePath" },
        "review_transport": { "$ref": "#/$defs/relativePath" },
        "review_repair_evidence": { "$ref": "#/$defs/relativePath" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "mandate_id", "model_selector", "role", "fallback"],
      "properties": {
        "binding": { "const": "owner-mandate-required" },
        "mandate_id": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^OM-[0-9]{3}$" }]
        },
        "model_selector": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
        },
        "role": { "const": "independent-read-only" },
        "fallback": { "const": "forbidden" }
      },
      "allOf": [
        {
          "if": { "properties": { "mandate_id": { "type": "null" } } },
          "then": { "properties": { "model_selector": { "type": "null" } } }
        },
        {
          "if": { "properties": { "model_selector": { "type": "string" } } },
          "then": { "properties": { "mandate_id": { "type": "string" } } }
        }
      ]
    },
    "review_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substantive_cycles",
        "transport_retries_per_cycle",
        "cycle_three",
        "cycle_two_failure"
      ],
      "properties": {
        "substantive_cycles": { "const": 2 },
        "transport_retries_per_cycle": { "const": 1 },
        "cycle_three": { "const": "forbidden" },
        "cycle_two_failure": { "const": "ESCALATION_REQUIRED" }
      }
    },
    "remote_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_cache_trusted", "gate_population"],
      "properties": {
        "local_cache_trusted": { "const": false },
        "gate_population": { "const": "complete-authoritative" }
      }
    },
    "deployment": { "enum": ["forbidden", "separately-authorized"] }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "round": "R-9999",
      "policy_version": "4.0.0",
      "decision_id": "DII-248",
      "phase": "pre-entry-preparation",
      "sources": {
        "authorization": "work/rounds/R-9999/AUTHORIZATION.md",
        "plan": "work/rounds/R-9999/plan.md",
        "orchestrator": "work/rounds/R-9999/prompts/00-orchestrator.md",
        "affected_test_graph": "work/rounds/R-9999/affected-test-graph.json",
        "obligations": "work/rounds/R-9999/review-obligations.json",
        "current_claims": "work/rounds/R-9999/current-claims.json"
      },
      "runtime": {
        "state_root": ".devai/state/round-runs/R-9999/close",
        "candidate_manifest": ".devai/state/round-runs/R-9999/close/candidate-manifest.json",
        "convergence_evidence": ".devai/state/round-runs/R-9999/close/convergence-evidence.json",
        "review_scope": ".devai/state/round-runs/R-9999/close/review-scope-manifest.json",
        "review_result": ".devai/state/round-runs/R-9999/close/review-result.json",
        "materialized_claims": ".devai/state/round-runs/R-9999/close/current-claims.json",
        "review_state": ".devai/state/round-runs/R-9999/close/review-state.json",
        "review_transport": ".devai/state/round-runs/R-9999/close/review-transport.json",
        "review_repair_evidence": ".devai/state/round-runs/R-9999/close/review-repair-evidence.json"
      },
      "reviewer": {
        "binding": "owner-mandate-required",
        "mandate_id": null,
        "model_selector": null,
        "role": "independent-read-only",
        "fallback": "forbidden"
      },
      "review_budget": {
        "substantive_cycles": 2,
        "transport_retries_per_cycle": 1,
        "cycle_three": "forbidden",
        "cycle_two_failure": "ESCALATION_REQUIRED"
      },
      "remote_ci": {
        "local_cache_trusted": false,
        "gate_population": "complete-authoritative"
      },
      "deployment": "forbidden"
    }
  ]
}
