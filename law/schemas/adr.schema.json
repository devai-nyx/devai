{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/adr.schema.json",
  "title": "Architecture Decision Record",
  "description": "Front-matter schema for ADR markdown files under docs/meta/adr/. The body of the file is markdown with mandatory sections (Status, Context, Decision, Consequences, Alternatives Considered, Affected Rules) enforced by the validator, not the schema. Absorbs the LAW-14.ADR.* shape from the stech-law predecessor draft (D-38).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adr_id",
    "title",
    "status",
    "date",
    "authors"
  ],
  "properties": {
    "adr_id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "rejected"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9_-]+$"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "schema_version": "1.0.0"
}