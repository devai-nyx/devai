{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/active-control-census.schema.json",
  "title": "Exact-candidate active control census",
  "description": "Candidate-tree-derived, self-digested population of every authority, decision, policy schema, graph, registry, and manifest governing one review candidate.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round",
    "candidate_sha",
    "candidate_tree",
    "policy_digest",
    "profile_digest",
    "entries",
    "entry_count",
    "population_digest",
    "census_digest_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "round": { "type": "string", "pattern": "^R-[0-9]{4}$" },
    "candidate_sha": { "$ref": "#/$defs/sha1" },
    "candidate_tree": { "$ref": "#/$defs/sha1" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "profile_digest": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "kind", "path", "status", "derivation", "raw_digest"],
        "properties": {
          "control_id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "owner-mandate",
              "architect-decision",
              "policy",
              "policy-schema",
              "round-profile",
              "affected-test-graph",
              "obligation-registry",
              "current-claim-registry",
              "prior-finding-registry",
              "round-declaration",
              "tracked-manifest"
            ]
          },
          "path": { "$ref": "#/$defs/relativePath" },
          "status": { "const": "active" },
          "derivation": {
            "enum": [
              "authority-reference",
              "decision-provenance",
              "policy-schema-map",
              "profile-source",
              "profile-manifest",
              "declaration-binding"
            ]
          },
          "raw_digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "entry_count": { "type": "integer", "minimum": 1 },
    "population_digest": { "$ref": "#/$defs/sha256" },
    "census_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "round": "R-9999",
      "candidate_sha": "1111111111111111111111111111111111111111",
      "candidate_tree": "2222222222222222222222222222222222222222",
      "policy_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "profile_digest": "4444444444444444444444444444444444444444444444444444444444444444",
      "entries": [
        {
          "control_id": "generic-round-close-controls",
          "kind": "policy",
          "path": "law/policy/round-close-controls.json",
          "status": "active",
          "derivation": "profile-source",
          "raw_digest": "5555555555555555555555555555555555555555555555555555555555555555"
        }
      ],
      "entry_count": 1,
      "population_digest": "6666666666666666666666666666666666666666666666666666666666666666",
      "census_digest_sha256": "7777777777777777777777777777777777777777777777777777777777777777"
    }
  ]
}
