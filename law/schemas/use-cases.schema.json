{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/use-cases.schema.json",
  "$comment": "REDOX-UseCases: absorbed from /Users/aarusso/Development/tools/redox/src/schemas/UseCases.schema.json in Phase 17.B (D-57). Distinct from DEVAI's journey.schema.json (operator-paths-through-DEVAI per D-48); use-cases here are inferred end-user flows discovered in adopter repos.",
  "title": "Use Cases (Adopter)",
  "description": "Inferred end-user use-case / journey inventory discovered by deterministic static introspection (controller summaries, route metadata, RBAC bindings) plus optional LLM-inferred actor/flow elaboration. Distinct from DEVAI's journey.schema.json (operator paths through DEVAI itself, per D-48). Emitted as a SensorReading body at tier L0 by inventory_coverage sensors (Phase 17.C). Per D-57 (brownfield-adoption substrate).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Optional machine timestamp. Hand-authored bundles omit this field rather than maintaining a freshness claim manually."
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UseCase"
      },
      "minItems": 1
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleCount": {
          "type": "integer",
          "minimum": 0
        },
        "caseCount": {
          "type": "integer",
          "minimum": 0
        },
        "stepCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Absorption/supersession provenance per the record meta-structure (§5.1)."
    },
    "supersedes": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": ["string", "null"]
    }
  },
  "required": ["schemaVersion", "roles", "cases"],
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["path", "startLine", "endLine"]
    },
    "Ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionRef"
          },
          "uniqueItems": true,
          "description": "Canonical CLI action identifiers associated with this use-case step."
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "endpointIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "ActionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Space-separated canonical CLI action path."
        },
        "provisional": {
          "const": true,
          "description": "Present only when id preserves the predecessor canonical path pending successor CLI binding."
        }
      },
      "required": ["id"]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "actorRole": {
          "type": "string"
        },
        "refs": {
          "$ref": "#/$defs/Ref"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      },
      "required": ["action"]
    },
    "AltFlow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      },
      "required": ["when", "steps"]
    },
    "Exception": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "handling": {
          "type": "string"
        }
      },
      "required": ["when", "handling"]
    },
    "UseCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mainFlow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1
        },
        "alternateFlows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AltFlow"
          },
          "default": []
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exception"
          },
          "default": []
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refs": {
          "$ref": "#/$defs/Ref"
        },
        "inferred": {
          "type": "boolean",
          "default": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      },
      "required": ["id", "title", "mainFlow"]
    }
  },
  "schema_version": "1.0.0",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "generatedAt": "2026-05-18T05:30:00.000Z",
      "roles": ["operator"],
      "cases": [
        {
          "id": "UC-devai-doctor",
          "title": "Operator runs doctor to verify repo health (self or adopter)",
          "mainFlow": [
            {
              "action": "Operator runs `devai doctor --self|--adopter|--auto --format human` (Phase 21.B)"
            }
          ]
        }
      ]
    }
  ]
}
