{
  "name": "@devai-nyx/core",
  "version": "1.0.0",
  "description": "Implementation-free public facade over the governed DEVAI package surface.",
  "license": "Apache-2.0",
  "author": "Antonio Augusto Russo <aarusso@nyxk.com.br>",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@devai-nyx/authority": "workspace:*",
    "@devai-nyx/cli": "workspace:*",
    "@devai-nyx/effects-check": "workspace:*",
    "@devai-nyx/evidence": "workspace:*",
    "@devai-nyx/loop": "workspace:*",
    "@devai-nyx/schemas": "workspace:*",
    "@devai-nyx/sensors": "workspace:*",
    "@devai-nyx/skills": "workspace:*",
    "@devai-nyx/spec": "workspace:*",
    "@devai-nyx/utils": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devai-nyx/devai.git",
    "directory": "packages/core"
  }
}
