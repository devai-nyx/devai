{
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "follow_up_questions"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "statement", "severity", "rationale"],
        "properties": {
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "severity": { "type": "string", "enum": ["must", "should"] },
          "rationale": { "type": "string" }
        }
      }
    },
    "follow_up_questions": { "type": "array", "items": { "type": "string" } }
  }
}
