{
  "type": "object",
  "additionalProperties": false,
  "required": ["blueprint", "gaps", "follow_up_questions"],
  "properties": {
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "module", "database"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "id": { "type": "string" },
        "module": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "namespace", "version"],
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entities"],
          "properties": {
            "entities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "primaryKey", "fields"],
                "properties": {
                  "name": { "type": "string" },
                  "primaryKey": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                  },
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name", "type"],
                      "properties": {
                        "name": { "type": "string" },
                        "type": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "follow_up_questions": { "type": "array", "items": { "type": "string" } }
  }
}
